@model MedicineFormViewModel
@{
    ViewData["Title"] = "Sửa " + Model.MedicineName;
}
<div class="pm-page-head">
    <div>
        <p class="pm-crumbs"><a asp-action="Index">Thuốc</a> / <a asp-action="Details" asp-route-id="@Model.MedicineId">@Model.MedicineCode</a> / Sửa</p>
        <h1 class="pm-title">Sửa thông tin thuốc</h1>
        <p class="pm-subtitle">@Model.MedicineCode · @Model.MedicineName</p>
    </div>
</div>

<partial name="_MedicineForm" model="Model" />

@section Scripts {
    <partial name="_FormValidation" />
    <script src="~/js/catalog.js" asp-append-version="true"></script>
}
