@model MedicineListViewModel
@{
    ViewData["Title"] = "Thuốc";
    var f = Model.Filter;
    string N(int n) => n.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"));
    string PageUrl(int page) => Url.Action("Index", new { f.Q, f.CategoryId, f.Type, f.Status, page })!;
}

<div class="pm-page-head">
    <div>
        <p class="pm-crumbs">Danh mục</p>
        <h1 class="pm-title">Thuốc</h1>
        <p class="pm-subtitle"><span data-pm-live="count" aria-live="polite">@if (f.Q is not null || f.CategoryId is not null || f.Type is not null || f.Status == "inactive")
            {
                <text>Tìm thấy @N(Model.Total) / @N(Model.GrandTotal) thuốc</text>
            }
            else if (Model.Total == Model.GrandTotal)
            {
                <text>@N(Model.GrandTotal) thuốc</text>
            }
            else
            {
                <text>@N(Model.Total) đang kinh doanh / @N(Model.GrandTotal) thuốc</text>
            }</span> · tìm theo tên, mã, mã vạch hoặc hoạt chất; gõ không dấu cũng được.</p>
    </div>
    @if (Model.CanCreate)
    {
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm thuốc</a>
    }
</div>

<form method="get" asp-action="Index" class="pm-card pm-filter mb-4" role="search" data-pm-live-search>
    <div class="pm-filter-search">
        <label for="q" class="visually-hidden">Tìm thuốc</label>
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" id="q" name="Q" value="@f.Q" class="form-control" placeholder="Tên, mã thuốc, mã vạch, hoạt chất…" autocomplete="off" />
    </div>
    <div>
        <label for="cat" class="visually-hidden">Nhóm thuốc</label>
        <select id="cat" name="CategoryId" class="form-select">
            <option value="">Tất cả nhóm</option>
            @foreach (var c in Model.Categories)
            {
                <!option value="@c.Id" selected="@(f.CategoryId == c.Id)">@c.Name</!option>
            }
        </select>
    </div>
    <div>
        <label for="type" class="visually-hidden">Loại thuốc</label>
        <select id="type" name="Type" class="form-select">
            <!option value="" selected="@(f.Type is null)">Tất cả loại thuốc</!option>
            <!option value="otc" selected="@(f.Type == "otc")">Không kê đơn</!option>
            <!option value="rx" selected="@(f.Type == "rx")">Kê đơn</!option>
        </select>
    </div>
    <div>
        <label for="status" class="visually-hidden">Trạng thái</label>
        <select id="status" name="Status" class="form-select">
            <!option value="active" selected="@(f.Status == "active")">Đang kinh doanh</!option>
            <!option value="inactive" selected="@(f.Status == "inactive")">Đã ngừng</!option>
            <!option value="all" selected="@(f.Status == "all")">Tất cả</!option>
        </select>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" data-pm-live-submit>Lọc</button>
        <span class="d-flex" data-pm-live="clear">
            @if (f.Q is not null || f.CategoryId is not null || f.Type is not null || f.Status != "active")
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Bỏ lọc</a>
            }
        </span>
    </div>
</form>

<section class="pm-card pm-live-results" aria-label="Danh sách thuốc" data-pm-live="results">
    @if (Model.Rows.Count == 0)
    {
        <div class="pm-empty">
            <i class="bi bi-capsule" aria-hidden="true"></i>
            @(f.Q is null ? "Chưa có thuốc nào trong nhóm đã chọn." : $"Không tìm thấy thuốc khớp “{f.Q}”.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="pm-table">
                <thead>
                    <tr>
                        <th scope="col">Thuốc</th>
                        <th scope="col">Nhóm</th>
                        <th scope="col" class="text-end">Giá bán</th>
                        <th scope="col">Loại</th>
                        <th scope="col"><span class="visually-hidden">Trạng thái</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr class="pm-row-link">
                            <td>
                                <a class="fw-semibold text-reset stretched-link" asp-action="Details" asp-route-id="@r.MedicineId">@r.Name</a>
                                <div class="small text-muted-pm">
                                    @r.Code@(string.IsNullOrEmpty(r.Strength) ? "" : " · " + r.Strength)@(string.IsNullOrEmpty(r.DosageForm) ? "" : " · " + r.DosageForm)
                                    @if (!string.IsNullOrEmpty(r.Ingredients))
                                    {
                                        <span> · @r.Ingredients</span>
                                    }
                                </div>
                            </td>
                            <td class="small">@r.CategoryName</td>
                            <td class="text-end num text-nowrap">@Format.Money(r.SellingPrice)<div class="small text-muted-pm">/ @r.BaseUnitName</div></td>
                            <td>
                                @if (r.IsPrescription)
                                {
                                    <span class="pm-badge warn">Kê đơn</span>
                                }
                                else
                                {
                                    <span class="pm-badge calm">Không kê đơn</span>
                                }
                                @if (r.IsControlledDrug)
                                {
                                    <span class="pm-badge bad">Kiểm soát</span>
                                }
                            </td>
                            <td>
                                @if (!r.IsActive)
                                {
                                    <span class="pm-badge mute">Đã ngừng</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.PageCount > 1)
        {
            <nav class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3" aria-label="Phân trang">
                <span class="small text-muted-pm">Trang @f.Page / @Model.PageCount</span>
                <div class="d-flex gap-2">
                    @if (f.Page > 1)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page - 1)" rel="prev"><i class="bi bi-chevron-left" aria-hidden="true"></i> Trước</a>
                    }
                    @if (f.Page < Model.PageCount)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page + 1)" rel="next">Sau <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    }
                </div>
            </nav>
        }
    }
</section>

@section Scripts {
    <script src="~/js/live-search.js" asp-append-version="true"></script>
}
