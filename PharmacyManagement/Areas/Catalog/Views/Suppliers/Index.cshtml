@model SupplierListViewModel
@{
    ViewData["Title"] = "Nhà cung cấp";
    var f = Model.Filter;
    string N(int n) => n.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"));
    string PageUrl(int page) => Url.Action("Index", new { f.Q, f.Status, page })!;
}

<div class="pm-page-head">
    <div>
        <p class="pm-crumbs">Danh mục</p>
        <h1 class="pm-title">Nhà cung cấp</h1>
        <p class="pm-subtitle"><span data-pm-live="count" aria-live="polite">@if (f.Q is not null || f.Status == "inactive")
            {
                <text>Tìm thấy @N(Model.Total) / @N(Model.GrandTotal) nhà cung cấp</text>
            }
            else if (Model.Total == Model.GrandTotal)
            {
                <text>@N(Model.GrandTotal) nhà cung cấp</text>
            }
            else
            {
                <text>@N(Model.Total) đang giao dịch / @N(Model.GrandTotal) nhà cung cấp</text>
            }</span> · tìm theo tên, mã, mã số thuế, số điện thoại hoặc người liên hệ; gõ không dấu cũng được.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm nhà cung cấp</a>
</div>

<form method="get" asp-action="Index" class="pm-card pm-filter mb-4" role="search" data-pm-live-search>
    <div class="pm-filter-search">
        <label for="q" class="visually-hidden">Tìm nhà cung cấp</label>
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" id="q" name="Q" value="@f.Q" class="form-control" placeholder="Tên, mã, mã số thuế, số điện thoại…" autocomplete="off" />
    </div>
    <div>
        <label for="status" class="visually-hidden">Trạng thái</label>
        <select id="status" name="Status" class="form-select">
            <!option value="active" selected="@(f.Status == "active")">Đang giao dịch</!option>
            <!option value="inactive" selected="@(f.Status == "inactive")">Đã ngừng</!option>
            <!option value="all" selected="@(f.Status == "all")">Tất cả</!option>
        </select>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" data-pm-live-submit>Lọc</button>
        <span class="d-flex" data-pm-live="clear">
            @if (f.Q is not null || f.Status != "active")
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Bỏ lọc</a>
            }
        </span>
    </div>
</form>

<section class="pm-card pm-live-results" aria-label="Danh sách nhà cung cấp" data-pm-live="results">
    @if (Model.Rows.Count == 0)
    {
        <div class="pm-empty">
            <i class="bi bi-building" aria-hidden="true"></i>
            @(f.Q is null ? "Chưa có nhà cung cấp nào ở trạng thái đã chọn." : $"Không tìm thấy nhà cung cấp khớp “{f.Q}”.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="pm-table">
                <thead>
                    <tr>
                        <th scope="col">Nhà cung cấp</th>
                        <th scope="col">Liên hệ</th>
                        <th scope="col">Mã số thuế</th>
                        <th scope="col"><span class="visually-hidden">Trạng thái</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr class="pm-row-link">
                            <td>
                                <a class="fw-semibold text-reset stretched-link" asp-action="Details" asp-route-id="@r.SupplierId">@r.Name</a>
                                <div class="small text-muted-pm">@r.Code</div>
                            </td>
                            <td class="small">
                                @(r.ContactPerson ?? "—")
                                @if (r.Phone is not null || r.Email is not null)
                                {
                                    <div class="text-muted-pm num">@ContactRules.DisplayPhone(r.Phone)@(r.Phone is not null && r.Email is not null ? " · " : "")@r.Email</div>
                                }
                            </td>
                            <td class="small num">@(r.TaxCode ?? "—")</td>
                            <td>
                                @if (!r.IsActive)
                                {
                                    <span class="pm-badge mute">Đã ngừng</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.PageCount > 1)
        {
            <nav class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3" aria-label="Phân trang">
                <span class="small text-muted-pm">Trang @f.Page / @Model.PageCount</span>
                <div class="d-flex gap-2">
                    @if (f.Page > 1)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page - 1)" rel="prev"><i class="bi bi-chevron-left" aria-hidden="true"></i> Trước</a>
                    }
                    @if (f.Page < Model.PageCount)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page + 1)" rel="next">Sau <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    }
                </div>
            </nav>
        }
    }
</section>

@section Scripts {
    <script src="~/js/live-search.js" asp-append-version="true"></script>
}
