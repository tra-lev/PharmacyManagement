@model SupplierDebtListViewModel
@{
    ViewData["Title"] = "Công nợ nhà cung cấp";
    var f = Model.Filter;
    string N(int n) => n.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"));
    string PageUrl(int page) => Url.Action("Index", new { f.Q, f.Show, page })!;
}

<div class="pm-page-head">
    <div>
        <p class="pm-crumbs">Kho</p>
        <h1 class="pm-title">Công nợ nhà cung cấp</h1>
        <p class="pm-subtitle"><span data-pm-live="count" aria-live="polite">@if (f.Q is not null)
            {
                <text>Tìm thấy @N(Model.Total) / @N(Model.GrandTotal) nhà cung cấp</text>
            }
            else if (f.Show is null)
            {
                <text>@N(Model.Total) còn nợ hoặc chờ tiền hoàn / @N(Model.GrandTotal) nhà cung cấp</text>
            }
            else
            {
                <text>@N(Model.GrandTotal) nhà cung cấp</text>
            }</span> · nợ tính theo phiếu nhập đã nhập kho trừ phiếu chi.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Payments"><i class="bi bi-receipt" aria-hidden="true"></i> Phiếu chi, thu</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6">
        <div class="pm-stat h-100" data-tone="@(Model.TotalRemaining > 0 ? "warn" : "calm")">
            <span class="l">Còn nợ nhà cung cấp</span>
            <span class="v">@Format.Money(Model.TotalRemaining)</span>
            <span class="s">Tổng các phiếu nhập chưa thanh toán đủ.</span>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="pm-stat h-100" data-tone="@(Model.TotalRefundPending > 0 ? "wait" : "calm")">
            <span class="l">Tiền hoàn chờ nhận</span>
            <span class="v">@Format.Money(Model.TotalRefundPending)</span>
            <span class="s">Phiếu trả đã xuất, nhà cung cấp chưa hoàn đủ.</span>
        </div>
    </div>
</div>

<form method="get" asp-action="Index" class="pm-card pm-filter pm-filter-1 mb-4" role="search" data-pm-live-search>
    <div class="pm-filter-search">
        <label for="q" class="visually-hidden">Tìm nhà cung cấp</label>
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" id="q" name="Q" value="@f.Q" class="form-control" placeholder="Tên hoặc mã nhà cung cấp…" autocomplete="off" />
    </div>
    <div>
        <label for="show" class="visually-hidden">Hiển thị</label>
        <select id="show" name="Show" class="form-select">
            <!option value="" selected="@(f.Show is null)">Còn nợ hoặc chờ tiền hoàn</!option>
            <!option value="all" selected="@(f.Show == "all")">Tất cả nhà cung cấp</!option>
        </select>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" data-pm-live-submit>Lọc</button>
        <span class="d-flex" data-pm-live="clear">
            @if (f.IsFiltered)
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Bỏ lọc</a>
            }
        </span>
    </div>
</form>

<section class="pm-card pm-live-results" aria-label="Công nợ theo nhà cung cấp" data-pm-live="results">
    @if (Model.Rows.Count == 0)
    {
        <div class="pm-empty">
            <i class="bi bi-cash-coin" aria-hidden="true"></i>
            @(f.Q is null ? "Không có nhà cung cấp nào còn nợ." : $"Không tìm thấy nhà cung cấp khớp “{f.Q}”.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="pm-table">
                <thead>
                    <tr>
                        <th scope="col">Nhà cung cấp</th>
                        <th scope="col" class="text-end">Tiền hàng đã nhập</th>
                        <th scope="col" class="text-end">Đã thanh toán</th>
                        <th scope="col" class="text-end">Còn nợ</th>
                        <th scope="col" class="text-end">Tiền hoàn chờ nhận</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr class="pm-row-link">
                            <td>
                                <a class="fw-semibold text-reset stretched-link" asp-action="Supplier" asp-route-id="@r.SupplierId">@r.Name</a>
                                <div class="small text-muted-pm num">@r.Code@(r.OpenReceipts > 0 ? " · " + N(r.OpenReceipts) + " phiếu nhập còn nợ" : "")</div>
                            </td>
                            <td class="text-end num text-nowrap">@Format.Money(r.Purchased)</td>
                            <td class="text-end num text-nowrap">@Format.Money(r.Paid)</td>
                            <td class="text-end num text-nowrap fw-semibold">@Format.Money(r.Remaining)</td>
                            <td class="text-end num text-nowrap">@(r.RefundPending > 0 ? Format.Money(r.RefundPending) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.PageCount > 1)
        {
            <nav class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3" aria-label="Phân trang">
                <span class="small text-muted-pm">Trang @f.Page / @Model.PageCount</span>
                <div class="d-flex gap-2">
                    @if (f.Page > 1)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page - 1)" rel="prev"><i class="bi bi-chevron-left" aria-hidden="true"></i> Trước</a>
                    }
                    @if (f.Page < Model.PageCount)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page + 1)" rel="next">Sau <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    }
                </div>
            </nav>
        }
    }
</section>

@section Scripts {
    <script src="~/js/live-search.js" asp-append-version="true"></script>
}
