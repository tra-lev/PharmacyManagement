@model SupplierPaymentListViewModel
@{
    ViewData["Title"] = "Phiếu chi, thu nhà cung cấp";
    var f = Model.Filter;
    string N(int n) => n.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"));
    string PageUrl(int page) => Url.Action("Payments", new { f.Q, f.Type, f.Status, page })!;
}

<div class="pm-page-head">
    <div>
        <p class="pm-crumbs"><a asp-action="Index">Công nợ nhà cung cấp</a> / Phiếu chi, thu</p>
        <h1 class="pm-title">Phiếu chi, thu nhà cung cấp</h1>
        <p class="pm-subtitle"><span data-pm-live="count" aria-live="polite">@if (f.IsFiltered)
            {
                <text>Tìm thấy @N(Model.Total) / @N(Model.GrandTotal) phiếu</text>
            }
            else
            {
                <text>@N(Model.GrandTotal) phiếu</text>
            }</span> · tìm theo mã phiếu, mã giao dịch, nhà cung cấp, phiếu nhập hoặc phiếu trả.</p>
    </div>
</div>

<form method="get" asp-action="Payments" class="pm-card pm-filter mb-4" role="search" data-pm-live-search>
    <div class="pm-filter-search">
        <label for="q" class="visually-hidden">Tìm phiếu</label>
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" id="q" name="Q" value="@f.Q" class="form-control" placeholder="Mã phiếu, mã giao dịch, nhà cung cấp…" autocomplete="off" />
    </div>
    <div>
        <label for="type" class="visually-hidden">Loại phiếu</label>
        <select id="type" name="Type" class="form-select">
            <!option value="" selected="@(f.Type is null)">Phiếu chi và phiếu thu</!option>
            <!option value="pay" selected="@(f.Type == "pay")">Phiếu chi</!option>
            <!option value="refund" selected="@(f.Type == "refund")">Phiếu thu tiền hoàn</!option>
        </select>
    </div>
    <div>
        <label for="status" class="visually-hidden">Trạng thái</label>
        <select id="status" name="Status" class="form-select">
            <!option value="" selected="@(f.Status is null)">Mọi trạng thái</!option>
            <!option value="ok" selected="@(f.Status == "ok")">Đã ghi nhận</!option>
            <!option value="void" selected="@(f.Status == "void")">Đã hủy</!option>
        </select>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" data-pm-live-submit>Lọc</button>
        <span class="d-flex" data-pm-live="clear">
            @if (f.IsFiltered)
            {
                <a class="btn btn-outline-secondary" asp-action="Payments">Bỏ lọc</a>
            }
        </span>
    </div>
</form>

<section class="pm-card pm-live-results" aria-label="Danh sách phiếu chi, thu" data-pm-live="results">
    @if (Model.Rows.Count == 0)
    {
        <div class="pm-empty">
            <i class="bi bi-receipt" aria-hidden="true"></i>
            @(f.Q is null ? "Chưa có phiếu nào khớp bộ lọc." : $"Không tìm thấy phiếu khớp “{f.Q}”.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="pm-table">
                <thead>
                    <tr>
                        <th scope="col">Phiếu</th>
                        <th scope="col">Nhà cung cấp</th>
                        <th scope="col">Chứng từ</th>
                        <th scope="col">Hình thức</th>
                        <th scope="col" class="text-end">Số tiền</th>
                        <th scope="col">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr class="pm-row-link">
                            <td>
                                <a class="fw-semibold text-reset stretched-link num" asp-action="Details" asp-route-id="@r.SupplierPaymentId">@r.Code</a>
                                <div class="small text-muted-pm">@SupplierPaymentText.Type(r.Type) · @Format.When(r.PaidAt)</div>
                            </td>
                            <td class="small">@r.SupplierName</td>
                            <td class="small num">@(r.DocumentCode ?? "—")</td>
                            <td class="small">@SupplierPaymentText.Method(r.Method)</td>
                            <td class="text-end num text-nowrap">@(r.Type == (byte)SupplierPaymentType.RefundFromSupplier ? "+" : "−")@Format.Money(r.Amount)</td>
                            <td><span class="pm-badge @SupplierPaymentText.Tone(r.Status)">@SupplierPaymentText.Status(r.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.PageCount > 1)
        {
            <nav class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3" aria-label="Phân trang">
                <span class="small text-muted-pm">Trang @f.Page / @Model.PageCount</span>
                <div class="d-flex gap-2">
                    @if (f.Page > 1)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page - 1)" rel="prev"><i class="bi bi-chevron-left" aria-hidden="true"></i> Trước</a>
                    }
                    @if (f.Page < Model.PageCount)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page + 1)" rel="next">Sau <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    }
                </div>
            </nav>
        }
    }
</section>

@section Scripts {
    <script src="~/js/live-search.js" asp-append-version="true"></script>
}
