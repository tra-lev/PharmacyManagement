@model SupplierReturnDetailsViewModel
@{
    ViewData["Title"] = "Phiếu trả " + Model.Code;
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    string Or(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    var shortLines = Model.IsDraft
        ? Model.Lines.Where(l => l.Quantity > l.BatchOnHand || l.LotStatus == (byte)BatchStatus.Recalled).ToList()
        : new List<SupplierReturnLineView>();
}

<div class="pm-page-head">
    <div>
        <p class="pm-crumbs"><a asp-action="Index">Trả nhà cung cấp</a> / @Model.Code</p>
        <h1 class="pm-title">Phiếu trả @Model.Code</h1>
        <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
            <span class="pm-badge @SupplierReturnStatusText.Tone(Model.Status)">@SupplierReturnStatusText.Of(Model.Status)</span>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.CanEdit)
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#issue-modal"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Xuất trả</button>
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.SupplierReturnId"><i class="bi bi-pencil" aria-hidden="true"></i> Sửa phiếu</a>
        }
        <a class="btn btn-outline-secondary" asp-action="Print" asp-route-id="@Model.SupplierReturnId" target="_blank" rel="noopener"><i class="bi bi-printer" aria-hidden="true"></i> In phiếu</a>
        @if (Model.CanEdit)
        {
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#cancel-modal">Hủy phiếu</button>
        }
    </div>
</div>

@if (shortLines.Count > 0)
{
    <div class="pm-alert warn mb-4" role="status">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        Chưa xuất trả được: @(string.Join("; ", shortLines.Select(l => l.MedicineName + " lô " + l.BatchNumber + (l.LotStatus == (byte)BatchStatus.Recalled ? " đang thu hồi" : " chỉ còn " + Format.Number(l.BatchOnHand) + " " + l.BaseUnit)))). Sửa phiếu trước khi xuất trả.
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <section class="pm-card h-100" aria-labelledby="d-head">
            <h2 id="d-head" class="pm-h2 mb-3">Thông tin phiếu</h2>
            <dl class="pm-dl">
                <dt>Nhà cung cấp</dt><dd>@Model.SupplierName <span class="text-muted-pm">(@Model.SupplierCode)</span></dd>
                <dt>Phiếu nhập gốc</dt>
                <dd class="num">
                    @if (Model.GoodsReceiptId is null)
                    {
                        <text>Không chọn</text>
                    }
                    else
                    {
                        <a asp-controller="Receipts" asp-action="Details" asp-route-id="@Model.GoodsReceiptId">@Model.GoodsReceiptCode</a>
                    }
                </dd>
                <dt>Ngày lập</dt><dd class="num">@Format.When(Model.ReturnDate)</dd>
                <dt>Người lập</dt><dd>@Model.CreatedByName</dd>
                @if (Model.IssuedAt is not null)
                {
                    <dt>Xuất trả lúc</dt><dd class="num">@Format.When(Model.IssuedAt.Value)</dd>
                }
                <dt>Lý do</dt><dd class="pm-pre">@Model.Reason</dd>
            </dl>
        </section>
    </div>
    <div class="col-lg-5">
        <section class="pm-card h-100" aria-labelledby="d-money">
            <h2 id="d-money" class="pm-h2 mb-3">Tiền hoàn</h2>
            <div class="pm-stat" data-tone="@(Model.Status == (byte)SupplierReturnStatus.Issued ? "warn" : "calm")">
                <span class="l">Nhà cung cấp phải hoàn</span>
                <span class="v">@Format.Money(Model.TotalAmount)</span>
                <span class="s">Đã nhận @Format.Money(Model.Refunded) · còn @Format.Money(Model.Remaining)</span>
            </div>
            @if (Model.IsDraft)
            {
                <p class="form-text mb-0 mt-3">Phiếu nháp chưa trừ tồn kho. Bấm Xuất trả khi đã giao hàng cho nhà cung cấp.</p>
            }
        </section>
    </div>
</div>

@if (Model.CanRefund)
{
    <section class="pm-card mb-4" aria-labelledby="d-refund">
        <h2 id="d-refund" class="pm-h2 mb-3">Thu tiền hoàn</h2>
        <form asp-action="Refund" asp-route-id="@Model.SupplierReturnId" method="post" class="row g-3 align-items-end" novalidate>
            <div class="col-sm-6 col-lg-3">
                <label for="refund-amount" class="form-label">Số tiền <span class="req">*</span></label>
                <div class="input-group">
                    <input type="text" id="refund-amount" name="Amount" value="@Format.MoneyInput(Math.Ceiling(Model.Remaining))" class="form-control text-end num" inputmode="numeric" autocomplete="off" data-pm-money required />
                    <span class="input-group-text">đ</span>
                </div>
            </div>
            <fieldset class="col-sm-6 col-lg-3">
                <legend class="form-label">Hình thức <span class="req">*</span></legend>
                <div class="pm-seg">
                    <label><input type="radio" name="Method" value="2" checked /> Chuyển khoản</label>
                    <label><input type="radio" name="Method" value="1" /> Tiền mặt</label>
                </div>
            </fieldset>
            <div class="col-sm-6 col-lg-3">
                <label for="refund-ref" class="form-label">Mã giao dịch <span class="opt">(bắt buộc khi chuyển khoản)</span></label>
                <input type="text" id="refund-ref" name="Reference" class="form-control" maxlength="100" autocomplete="off" placeholder="FT26110712345" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label for="refund-note" class="form-label">Ghi chú <span class="opt">(không bắt buộc)</span></label>
                <input type="text" id="refund-note" name="Notes" class="form-control" maxlength="500" autocomplete="off" />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary"><i class="bi bi-cash-coin" aria-hidden="true"></i> Lập phiếu thu</button>
                <span class="form-text ms-2">Thu đủ số còn lại thì phiếu trả chuyển sang Đã quyết toán.</span>
            </div>
        </form>
    </section>
}

<section class="pm-card mb-4" aria-labelledby="d-lines">
    <h2 id="d-lines" class="pm-h2 mb-3">Lô trả</h2>
    <div class="table-responsive">
        <table class="pm-table">
            <thead>
                <tr>
                    <th scope="col">Thuốc</th>
                    <th scope="col">Lô, hạn dùng</th>
                    <th scope="col" class="text-end">Số lượng</th>
                    <th scope="col" class="text-end">Đơn giá trả</th>
                    <th scope="col" class="text-end">Thành tiền</th>
                    <th scope="col">Ghi chú</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Lines)
                {
                    <tr>
                        <td>
                            <span class="fw-semibold">@l.MedicineName</span>
                            <div class="small text-muted-pm num">@l.MedicineCode</div>
                        </td>
                        <td class="small">
                            <a class="num" asp-controller="Stock" asp-action="Batch" asp-route-id="@l.BatchId">@l.BatchNumber</a>
                            <div class="text-muted-pm num">HSD @l.ExpiryDate.ToString("dd/MM/yyyy", vi)</div>
                        </td>
                        <td class="text-end num text-nowrap">
                            @StockText.Quantity(l.Quantity, l.BaseUnit)
                            @if (Model.IsDraft)
                            {
                                <div class="small text-muted-pm">Tồn lô: @Format.Number(l.BatchOnHand)</div>
                            }
                        </td>
                        <td class="text-end num text-nowrap">@Format.Money(l.UnitCost)</td>
                        <td class="text-end num text-nowrap">@Format.Money(l.LineTotal)</td>
                        <td class="small">@Or(l.Reason)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th scope="row" colspan="4" class="text-end">Tổng tiền hoàn</th>
                    <td class="text-end num text-nowrap fw-semibold">@Format.Money(Model.TotalAmount)</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</section>

@if (Model.Refunds.Count > 0)
{
    <section class="pm-card" aria-labelledby="d-payments">
        <h2 id="d-payments" class="pm-h2 mb-3">Phiếu thu tiền hoàn</h2>
        <div class="table-responsive">
            <table class="pm-table">
                <thead>
                    <tr>
                        <th scope="col">Phiếu</th>
                        <th scope="col">Hình thức</th>
                        <th scope="col" class="text-end">Số tiền</th>
                        <th scope="col">Người lập</th>
                        <th scope="col">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Refunds)
                    {
                        <tr>
                            <td class="num">
                                @if (Model.CanOpenPayments)
                                {
                                    <a asp-controller="SupplierPayments" asp-action="Details" asp-route-id="@p.SupplierPaymentId">@p.Code</a>
                                }
                                else
                                {
                                    @p.Code
                                }
                                <div class="small text-muted-pm">@Format.When(p.PaidAt)</div>
                            </td>
                            <td class="small">@SupplierPaymentText.Method(p.Method)@(p.Reference is null ? "" : " · " + p.Reference)</td>
                            <td class="text-end num text-nowrap">@Format.Money(p.Amount)</td>
                            <td class="small">@p.EmployeeName</td>
                            <td><span class="pm-badge @SupplierPaymentText.Tone(p.Status)">@SupplierPaymentText.Status(p.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (Model.CanEdit)
{
    <div class="modal fade" id="issue-modal" tabindex="-1" aria-labelledby="issue-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" asp-action="Issue" asp-route-id="@Model.SupplierReturnId" method="post">
                <div class="modal-header">
                    <h2 class="modal-title pm-h2" id="issue-title">Xuất trả phiếu @Model.Code?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Tồn kho của @Model.Lines.Count lô giảm theo số lượng trả. Đã xuất trả thì không sửa hay hủy phiếu được nữa.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Chưa xuất trả</button>
                    <button type="submit" class="btn btn-primary">Xuất trả</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="cancel-modal" tabindex="-1" aria-labelledby="cancel-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" asp-action="Cancel" asp-route-id="@Model.SupplierReturnId" method="post">
                <div class="modal-header">
                    <h2 class="modal-title pm-h2" id="cancel-title">Hủy phiếu @Model.Code?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <p>Phiếu chuyển sang trạng thái Đã hủy, vẫn lưu để tra cứu; tồn kho không đổi.</p>
                    <label for="cancel-reason" class="form-label">Lý do hủy phiếu <span class="req">*</span></label>
                    <input type="text" id="cancel-reason" name="reason" class="form-control" maxlength="300" required autocomplete="off" placeholder="Ví dụ: nhà cung cấp đồng ý đổi hàng thay vì nhận lại" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Không hủy</button>
                    <button type="submit" class="btn btn-danger">Hủy phiếu</button>
                </div>
            </form>
        </div>
    </div>
}
