@model PurchaseOrderListViewModel
@{
    ViewData["Title"] = "Đặt hàng";
    var f = Model.Filter;
    string N(int n) => n.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"));
    string PageUrl(int page) => Url.Action("Index", new { f.Q, f.Status, f.SupplierId, page })!;
    var filtered = f.Q is not null || f.Status is not null || f.SupplierId is not null;
}

<div class="pm-page-head">
    <div>
        <p class="pm-crumbs">Kho</p>
        <h1 class="pm-title">Đặt hàng</h1>
        <p class="pm-subtitle"><span data-pm-live="count" aria-live="polite">@if (filtered)
            {
                <text>Tìm thấy @N(Model.Total) / @N(Model.GrandTotal) đơn</text>
            }
            else
            {
                <text>@N(Model.GrandTotal) đơn đặt hàng</text>
            }</span> · tìm theo mã đơn hoặc tên nhà cung cấp.</p>
    </div>
    @if (Model.CanCreate)
    {
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> Lập đơn đặt hàng</a>
    }
</div>

@if (Model.CanCreate && Model.LowStockCount > 0)
{
    <div class="pm-alert warn mb-4 d-flex flex-wrap align-items-center justify-content-between gap-2" role="status">
        <span><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Có @Model.LowStockCount thuốc dưới mức tồn tối thiểu.</span>
        <a class="btn btn-sm btn-outline-secondary" asp-action="Create" asp-route-suggest="true"><i class="bi bi-lightbulb" aria-hidden="true"></i> Lập đơn cho các thuốc này</a>
    </div>
}

<form method="get" asp-action="Index" class="pm-card pm-filter mb-4" role="search" data-pm-live-search>
    <div class="pm-filter-search">
        <label for="q" class="visually-hidden">Tìm đơn đặt hàng</label>
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" id="q" name="Q" value="@f.Q" class="form-control" placeholder="Mã đơn hoặc tên nhà cung cấp…" autocomplete="off" />
    </div>
    <div>
        <label for="status" class="visually-hidden">Trạng thái</label>
        <select id="status" name="Status" class="form-select">
            <!option value="" selected="@(f.Status is null)">Mọi trạng thái</!option>
            <!option value="draft" selected="@(f.Status == "draft")">Nháp</!option>
            <!option value="awaiting" selected="@(f.Status == "awaiting")">Chờ giao</!option>
            <!option value="partial" selected="@(f.Status == "partial")">Giao thiếu</!option>
            <!option value="delivered" selected="@(f.Status == "delivered")">Đã giao</!option>
            <!option value="cancelled" selected="@(f.Status == "cancelled")">Đã hủy</!option>
        </select>
    </div>
    <div>
        <label for="supplier" class="visually-hidden">Nhà cung cấp</label>
        <select id="supplier" name="SupplierId" class="form-select">
            <!option value="" selected="@(f.SupplierId is null)">Mọi nhà cung cấp</!option>
            @foreach (var s in Model.Suppliers)
            {
                <!option value="@s.Id" selected="@(s.Id == f.SupplierId)">@s.Name</!option>
            }
        </select>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" data-pm-live-submit>Lọc</button>
        <span class="d-flex" data-pm-live="clear">
            @if (filtered)
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Bỏ lọc</a>
            }
        </span>
    </div>
</form>

<section class="pm-card pm-live-results" aria-label="Danh sách đơn đặt hàng" data-pm-live="results">
    @if (Model.Rows.Count == 0)
    {
        <div class="pm-empty">
            <i class="bi bi-clipboard" aria-hidden="true"></i>
            @(f.Q is null ? (filtered ? "Chưa có đơn nào khớp bộ lọc." : "Chưa có đơn đặt hàng nào.") : $"Không tìm thấy đơn khớp “{f.Q}”.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="pm-table">
                <thead>
                    <tr>
                        <th scope="col">Đơn</th>
                        <th scope="col">Nhà cung cấp</th>
                        <th scope="col">Nhận hàng</th>
                        <th scope="col" class="text-end">Tổng tiền</th>
                        <th scope="col">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr class="pm-row-link">
                            <td>
                                <a class="fw-semibold text-reset stretched-link num" asp-action="Details" asp-route-id="@r.PurchaseOrderId">@r.Code</a>
                                <div class="small text-muted-pm num">Lập @r.OrderDate.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)@(r.ExpectedDeliveryDate is null ? "" : " · giao " + r.ExpectedDeliveryDate.Value.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture))</div>
                            </td>
                            <td>@r.SupplierName</td>
                            <td class="small num">@r.FullLines/@r.LineCount thuốc đủ</td>
                            <td class="text-end num text-nowrap">@Format.Money(r.TotalAmount)</td>
                            <td><span class="pm-badge @PurchaseOrderStatusText.Tone(r.Status)">@PurchaseOrderStatusText.Of(r.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.PageCount > 1)
        {
            <nav class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3" aria-label="Phân trang">
                <span class="small text-muted-pm">Trang @f.Page / @Model.PageCount</span>
                <div class="d-flex gap-2">
                    @if (f.Page > 1)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page - 1)" rel="prev"><i class="bi bi-chevron-left" aria-hidden="true"></i> Trước</a>
                    }
                    @if (f.Page < Model.PageCount)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page + 1)" rel="next">Sau <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    }
                </div>
            </nav>
        }
    }
</section>

@section Scripts {
    <script src="~/js/live-search.js" asp-append-version="true"></script>
}
