@model BatchListViewModel
@{
    var full = Model.FullView;
    ViewData["Title"] = (full ? "Tồn kho" : "Tra cứu thuốc & tồn") + " theo lô";
    var f = Model.Filter;
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    string N(int n) => n.ToString("N0", vi);
    var searching = f.Q is not null || f.Status is not null || f.LocationId is not null || f.MedicineId is not null;
    string PageUrl(int page) => Url.Action("Batches", new { f.Q, f.Status, f.LocationId, f.Show, f.MedicineId, page })!;
}

<div class="pm-page-head">
    <div>
        <p class="pm-crumbs">@(full ? "Kho" : "Bán hàng") / <a asp-action="Index">@(full ? "Tồn kho" : "Tra cứu thuốc & tồn")</a></p>
        <h1 class="pm-title">@(Model.MedicineName is null ? "Tồn kho theo lô" : "Các lô của " + Model.MedicineName)</h1>
        <p class="pm-subtitle"><span data-pm-live="count" aria-live="polite">@if (searching)
            {
                <text>Tìm thấy @N(Model.Total) / @N(Model.GrandTotal) lô</text>
            }
            else if (Model.Total < Model.GrandTotal)
            {
                <text>@N(Model.Total) lô còn hàng / @N(Model.GrandTotal) lô</text>
            }
            else
            {
                <text>@N(Model.GrandTotal) lô</text>
            }</span> · hạn dùng gần xếp trước.</p>
    </div>
    @if (Model.MedicineName is not null)
    {
        <a class="btn btn-outline-secondary" asp-action="Medicine" asp-route-id="@f.MedicineId"><i class="bi bi-capsule" aria-hidden="true"></i> Xem thuốc</a>
    }
</div>

<partial name="_StockTabs" model="@("batches")" />

@if (full)
{
    <partial name="_StockAlerts" model="@(new StockAlertPanel(Model.Alerts, Model.WarningDays))" />
}

<form method="get" asp-action="Batches" class="pm-card pm-filter mb-4" role="search" data-pm-live-search>
    @if (f.MedicineId is not null)
    {
        <input type="hidden" name="MedicineId" value="@f.MedicineId" />
    }
    <div class="pm-filter-search">
        <label for="q" class="visually-hidden">Tìm lô</label>
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" id="q" name="Q" value="@f.Q" class="form-control" placeholder="Số lô, tên thuốc, mã thuốc…" autocomplete="off" />
    </div>
    <div>
        <label for="status" class="visually-hidden">Tình trạng lô</label>
        <select id="status" name="Status" class="form-select">
            <!option value="" selected="@(f.Status is null)">Mọi tình trạng</!option>
            <!option value="sellable" selected="@(f.Status == "sellable")">Bán được</!option>
            <!option value="near" selected="@(f.Status == "near")">Cận hạn</!option>
            <!option value="expired" selected="@(f.Status == "expired")">Hết hạn</!option>
            <!option value="blocked" selected="@(f.Status == "blocked")">Bị khóa, thu hồi</!option>
        </select>
    </div>
    <div>
        <label for="location" class="visually-hidden">Vị trí</label>
        <select id="location" name="LocationId" class="form-select">
            <option value="">Mọi vị trí</option>
            @foreach (var l in Model.Locations)
            {
                <!option value="@l.Id" selected="@(f.LocationId == l.Id)">@l.Name</!option>
            }
        </select>
    </div>
    <div>
        <label for="show" class="visually-hidden">Lô hiển thị</label>
        <select id="show" name="Show" class="form-select">
            <!option value="" selected="@(f.Show is null)">Lô còn hàng</!option>
            <!option value="all" selected="@(f.Show == "all")">Cả lô đã hết hàng</!option>
        </select>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" data-pm-live-submit>Lọc</button>
        <span class="d-flex" data-pm-live="clear">
            @if (f.IsFiltered)
            {
                <a class="btn btn-outline-secondary" asp-action="Batches">Bỏ lọc</a>
            }
        </span>
    </div>
</form>

<section class="pm-card pm-live-results" aria-label="Tồn kho theo lô" data-pm-live="results">
    @if (Model.Rows.Count == 0)
    {
        <div class="pm-empty">
            <i class="bi bi-box-seam" aria-hidden="true"></i>
            @(f.Q is null ? "Không có lô nào khớp bộ lọc." : $"Không tìm thấy lô khớp “{f.Q}”.")
        </div>
    }
    else
    {
        if (f.Status == "expired" && Model.CanDispose)
        {
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <span class="small text-muted-pm">Lô hết hạn không bán được, cần lập biên bản hủy.</span>
                <a class="btn btn-primary" asp-controller="Disposals" asp-action="Create" asp-route-expired="true"><i class="bi bi-trash3" aria-hidden="true"></i> Lập biên bản hủy tất cả lô hết hạn</a>
            </div>
        }
        <div class="table-responsive">
            <table class="pm-table">
                <thead>
                    <tr>
                        <th scope="col">Lô</th>
                        <th scope="col">Thuốc</th>
                        <th scope="col">Hạn dùng</th>
                        <th scope="col" class="text-end">Tồn</th>
                        <th scope="col">Vị trí</th>
                        @if (full)
                        {
                            <th scope="col">Nhập từ</th>
                        }
                        <th scope="col">Tình trạng</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr class="pm-row-link">
                            <td>
                                @if (full)
                                {
                                    <a class="fw-semibold text-reset stretched-link num" asp-action="Batch" asp-route-id="@r.BatchId">@r.BatchNumber</a>
                                }
                                else
                                {
                                    <a class="fw-semibold text-reset stretched-link num" asp-action="Medicine" asp-route-id="@r.MedicineId">@r.BatchNumber</a>
                                }
                                <div class="small text-muted-pm num">Nhập @r.ReceivedDate.ToString("dd/MM/yyyy", vi)</div>
                            </td>
                            <td>
                                @r.MedicineName
                                <div class="small text-muted-pm num">@r.MedicineCode</div>
                            </td>
                            <td class="num text-nowrap">
                                @r.ExpiryDate.ToString("dd/MM/yyyy", vi)
                                <div class="small @(r.Condition is BatchCondition.NearExpiry or BatchCondition.Expired ? "fw-semibold" : "text-muted-pm")">@StockText.DaysLeft(r.DaysLeft)</div>
                            </td>
                            <td class="text-end num text-nowrap">
                                @StockText.Quantity(r.Quantity, r.BaseUnit)
                                @if (r.Breakdown is not null)
                                {
                                    <div class="small text-muted-pm">@r.Breakdown</div>
                                }
                            </td>
                            <td class="small">@(r.Location ?? "Chưa xếp kệ")</td>
                            @if (full)
                            {
                                <td class="small">
                                    @if (r.GoodsReceiptCode is null)
                                    {
                                        <span class="text-muted-pm">—</span>
                                    }
                                    else
                                    {
                                        <span class="num">@r.GoodsReceiptCode</span>
                                        <div class="text-muted-pm">@r.SupplierName</div>
                                    }
                                </td>
                            }
                            <td><span class="pm-badge @StockText.Tone(r.Condition)">@StockText.Condition(r.Condition, r.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.PageCount > 1)
        {
            <nav class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3" aria-label="Phân trang">
                <span class="small text-muted-pm">Trang @f.Page / @Model.PageCount</span>
                <div class="d-flex gap-2">
                    @if (f.Page > 1)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page - 1)" rel="prev"><i class="bi bi-chevron-left" aria-hidden="true"></i> Trước</a>
                    }
                    @if (f.Page < Model.PageCount)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page + 1)" rel="next">Sau <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    }
                </div>
            </nav>
        }
    }
</section>

@section Scripts {
    <script src="~/js/live-search.js" asp-append-version="true"></script>
}
