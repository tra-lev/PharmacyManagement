@model StocktakeListViewModel
@{
    ViewData["Title"] = "Kiểm kê";
    var f = Model.Filter;
    string N(int n) => n.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"));
    string PageUrl(int page) => Url.Action("Index", new { f.Q, f.Status, page })!;
}

<div class="pm-page-head">
    <div>
        <p class="pm-crumbs">Kho</p>
        <h1 class="pm-title">Kiểm kê</h1>
        <p class="pm-subtitle"><span data-pm-live="count" aria-live="polite">@if (f.IsFiltered)
            {
                <text>Tìm thấy @N(Model.Total) / @N(Model.GrandTotal) phiếu kiểm kê</text>
            }
            else
            {
                <text>@N(Model.GrandTotal) phiếu kiểm kê</text>
            }</span> · tìm theo mã phiếu hoặc phạm vi kiểm kê.</p>
    </div>
    @if (Model.CanCreate)
    {
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> Kiểm kê mới</a>
    }
</div>

<form method="get" asp-action="Index" class="pm-card pm-filter pm-filter-1 mb-4" role="search" data-pm-live-search>
    <div class="pm-filter-search">
        <label for="q" class="visually-hidden">Tìm phiếu kiểm kê</label>
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" id="q" name="Q" value="@f.Q" class="form-control" placeholder="Mã phiếu, tủ, kệ, nhóm thuốc…" autocomplete="off" />
    </div>
    <div>
        <label for="status" class="visually-hidden">Trạng thái</label>
        <select id="status" name="Status" class="form-select">
            <!option value="" selected="@(f.Status is null)">Mọi trạng thái</!option>
            <!option value="counting" selected="@(f.Status == "counting")">Đang kiểm đếm</!option>
            <!option value="pending" selected="@(f.Status == "pending")">Chờ duyệt</!option>
            <!option value="approved" selected="@(f.Status == "approved")">Đã duyệt, chờ điều chỉnh</!option>
            <!option value="adjusted" selected="@(f.Status == "adjusted")">Đã điều chỉnh</!option>
            <!option value="rejected" selected="@(f.Status == "rejected")">Bị từ chối</!option>
        </select>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" data-pm-live-submit>Lọc</button>
        <span class="d-flex" data-pm-live="clear">
            @if (f.IsFiltered)
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Bỏ lọc</a>
            }
        </span>
    </div>
</form>

<section class="pm-card pm-live-results" aria-label="Danh sách phiếu kiểm kê" data-pm-live="results">
    @if (Model.Rows.Count == 0)
    {
        <div class="pm-empty">
            <i class="bi bi-clipboard-check" aria-hidden="true"></i>
            @(f.Q is null ? "Chưa có phiếu kiểm kê nào khớp bộ lọc." : $"Không tìm thấy phiếu kiểm kê khớp “{f.Q}”.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="pm-table">
                <thead>
                    <tr>
                        <th scope="col">Phiếu</th>
                        <th scope="col">Phạm vi</th>
                        <th scope="col" class="text-end">Lô chênh lệch</th>
                        <th scope="col">Người lập</th>
                        <th scope="col">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr class="pm-row-link">
                            <td>
                                <a class="fw-semibold text-reset stretched-link num" asp-action="Details" asp-route-id="@r.StocktakeId">@r.Code</a>
                                <div class="small text-muted-pm num">@Format.When(r.StocktakeDate) · @N(r.LineCount) lô</div>
                            </td>
                            <td class="small">@r.Scope</td>
                            <td class="text-end num">@(r.Status == (byte)StocktakeStatus.Counting ? "—" : N(r.DifferenceCount))</td>
                            <td class="small">@r.CreatedByName</td>
                            <td><span class="pm-badge @StocktakeStatusText.Tone(r.Status)">@StocktakeStatusText.Of(r.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.PageCount > 1)
        {
            <nav class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3" aria-label="Phân trang">
                <span class="small text-muted-pm">Trang @f.Page / @Model.PageCount</span>
                <div class="d-flex gap-2">
                    @if (f.Page > 1)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page - 1)" rel="prev"><i class="bi bi-chevron-left" aria-hidden="true"></i> Trước</a>
                    }
                    @if (f.Page < Model.PageCount)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page + 1)" rel="next">Sau <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    }
                </div>
            </nav>
        }
    }
</section>

@section Scripts {
    <script src="~/js/live-search.js" asp-append-version="true"></script>
}
