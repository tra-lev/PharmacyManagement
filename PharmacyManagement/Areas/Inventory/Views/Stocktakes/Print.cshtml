@model StocktakeDetailsViewModel
@{
    Layout = null;
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var i = 0;
    string Signed(decimal value) => value == 0 ? "0" : (value > 0 ? "+" : "−") + Format.Number(Math.Abs(value));
    var title = Model.Status switch
    {
        (byte)StocktakeStatus.PendingApproval => "BIÊN BẢN KIỂM KÊ (CHỜ DUYỆT)",
        (byte)StocktakeStatus.Rejected => "BIÊN BẢN KIỂM KÊ (BỊ TỪ CHỐI)",
        _ => "BIÊN BẢN KIỂM KÊ"
    };
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Biên bản kiểm kê @Model.Code · @Model.PharmacyName</title>
    <style>
        @@page { size: A4; margin: 14mm 12mm; }
        * { box-sizing: border-box; }
        body { margin: 0; padding: 24px; font-family: "Segoe UI", Arial, sans-serif; font-size: 12.5px; color: #13302F; background: #fff; }
        .sheet { max-width: 800px; margin: 0 auto; }
        .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; border-bottom: 2px solid #13302F; padding-bottom: 12px; margin-bottom: 16px; }
        .brand { font-size: 18px; font-weight: 700; }
        h1 { font-size: 20px; margin: 0 0 4px; text-align: right; }
        .right { text-align: right; }
        .muted { color: #4E6664; }
        .box { border: 1px solid #C9D8D5; border-radius: 8px; padding: 10px 12px; margin-bottom: 16px; }
        .box b { display: inline-block; min-width: 120px; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
        th, td { border: 1px solid #C9D8D5; padding: 6px 8px; vertical-align: top; }
        th { background: #F1F6F5; text-align: left; }
        thead { display: table-header-group; }
        tr { page-break-inside: avoid; }
        .r { text-align: right; white-space: nowrap; }
        .num-col { width: 32px; }
        .pre { white-space: pre-line; }
        .sign { display: grid; grid-template-columns: 1fr 1fr 1fr; text-align: center; margin-top: 28px; gap: 8px; }
        .sign div { min-height: 100px; }
        .tools { text-align: right; margin-bottom: 16px; }
        .tools button { font: inherit; padding: 8px 18px; border-radius: 999px; border: 0; background: #0B3B3E; color: #fff; cursor: pointer; }
        @@media print { body { padding: 0; } .tools { display: none; } }
    </style>
</head>
<body>
    <div class="sheet">
        <div class="tools"><button type="button" onclick="window.print()">In / Lưu PDF</button></div>
        <div class="head">
            <div>
                <div class="brand">@Model.PharmacyName</div>
                <div class="muted">Kho: @Model.WarehouseName</div>
            </div>
            <div>
                <h1>@title</h1>
                <div class="muted right">Số: <b>@Model.Code</b> · Ngày @Model.StocktakeDate.ToString("dd/MM/yyyy", vi)</div>
            </div>
        </div>

        <div class="box">
            <div><b>Phạm vi:</b> @Model.Scope</div>
            <div><b>Người lập:</b> @Model.CreatedByName</div>
            <div><b>Kết quả:</b> @Model.DifferenceCount / @Model.Lines.Count lô chênh lệch · thiếu @Format.Money(-Model.ShortageValue) · thừa @Format.Money(Model.SurplusValue) (theo giá vốn)</div>
            @if (Model.ApprovedByName is not null)
            {
                <div><b>@(Model.Status == (byte)StocktakeStatus.Rejected ? "Từ chối:" : "Duyệt:")</b> @Model.ApprovedByName · @Format.When(Model.ApprovedAt!.Value)@(string.IsNullOrWhiteSpace(Model.ApprovalNote) ? "" : " · " + Model.ApprovalNote)</div>
            }
            @if (Model.AdjustedByName is not null)
            {
                <div><b>Điều chỉnh tồn:</b> @Model.AdjustedByName · @Format.When(Model.AdjustedAt!.Value)</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="pre"><b>Ghi chú:</b> @Model.Notes</div>
            }
        </div>

        <table>
            <thead>
                <tr>
                    <th class="num-col">#</th>
                    <th>Thuốc</th>
                    <th>Số lô</th>
                    <th>Vị trí</th>
                    <th class="r">Tồn sổ sách</th>
                    <th class="r">Thực tế</th>
                    <th class="r">Chênh lệch</th>
                    <th>Lý do</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Lines)
                {
                    i++;
                    <tr>
                        <td>@i</td>
                        <td>@l.MedicineName<br /><span class="muted">@l.MedicineCode · @l.BaseUnit</span></td>
                        <td>@l.BatchNumber<br /><span class="muted">HSD @l.ExpiryDate.ToString("dd/MM/yyyy", vi)</span></td>
                        <td>@(l.Location ?? "—")</td>
                        <td class="r">@Format.Number(l.SystemQuantity)</td>
                        <td class="r">@Format.Number(l.ActualQuantity)</td>
                        <td class="r">@Signed(l.Difference)</td>
                        <td>@(l.Reason ?? "")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="sign">
            <div><b>Người kiểm kê</b><br /><span class="muted">(ký, ghi rõ họ tên)</span><br /><br /><br />@Model.CreatedByName</div>
            <div><b>Quản lý kho</b><br /><span class="muted">(ký, ghi rõ họ tên)</span></div>
            <div><b>Chủ nhà thuốc</b><br /><span class="muted">(ký, ghi rõ họ tên)</span><br /><br /><br />@(Model.ApprovedByName ?? "")</div>
        </div>
    </div>
</body>
</html>
