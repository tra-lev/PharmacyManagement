@model CountSheetViewModel
@{
    Layout = null;
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var i = 0;
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Phiếu kiểm kê @(Model.StocktakeCode ?? "") · @Model.PharmacyName</title>
    <style>
        @@page { size: A4; margin: 14mm 12mm; }
        * { box-sizing: border-box; }
        body { margin: 0; padding: 24px; font-family: "Segoe UI", Arial, sans-serif; font-size: 12.5px; color: #13302F; background: #fff; }
        .sheet { max-width: 800px; margin: 0 auto; }
        .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; border-bottom: 2px solid #13302F; padding-bottom: 12px; margin-bottom: 16px; }
        .brand { font-size: 18px; font-weight: 700; }
        h1 { font-size: 20px; margin: 0 0 4px; text-align: right; }
        .right { text-align: right; }
        .muted { color: #4E6664; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
        th, td { border: 1px solid #C9D8D5; padding: 6px 8px; vertical-align: top; }
        th { background: #F1F6F5; text-align: left; }
        thead { display: table-header-group; }
        tr { page-break-inside: avoid; }
        .blank { width: 110px; }
        .note { width: 150px; }
        .sign { display: grid; grid-template-columns: 1fr 1fr; text-align: center; margin-top: 28px; }
        .sign div { min-height: 90px; }
        .tools { text-align: right; margin-bottom: 16px; }
        .tools button { font: inherit; padding: 8px 18px; border-radius: 999px; border: 0; background: #0B3B3E; color: #fff; cursor: pointer; }
        @@media print { body { padding: 0; } .tools { display: none; } }
    </style>
</head>
<body>
    <div class="sheet">
        <div class="tools"><button type="button" onclick="window.print()">In / Lưu PDF</button></div>
        <div class="head">
            <div>
                <div class="brand">@Model.PharmacyName</div>
                <div class="muted">Kho: @Model.WarehouseName</div>
            </div>
            <div>
                <h1>PHIẾU KIỂM KÊ</h1>
                <div class="muted right">@(Model.StocktakeCode is null ? "" : "Số: " + Model.StocktakeCode + " · ")In lúc @Format.When(Model.PrintedAt)</div>
            </div>
        </div>

        <p><b>Phạm vi:</b> @Model.ScopeLabel · @Model.Lines.Count lô. Đếm thực tế từng lô, ghi số lượng theo đơn vị cơ sở; lô thừa, thiếu, hỏng ghi rõ ở cột ghi chú.</p>

        <table>
            <thead>
                <tr>
                    <th style="width:32px">#</th>
                    <th>Vị trí</th>
                    <th>Thuốc</th>
                    <th>Số lô</th>
                    <th>Hạn dùng</th>
                    <th>Đơn vị</th>
                    <th class="blank">Số đếm được</th>
                    <th class="note">Ghi chú</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Lines)
                {
                    i++;
                    <tr>
                        <td>@i</td>
                        <td>@(l.Location ?? "Chưa xếp kệ")</td>
                        <td>@l.MedicineName<br /><span class="muted">@l.MedicineCode</span></td>
                        <td>@l.BatchNumber</td>
                        <td>@l.ExpiryDate.ToString("dd/MM/yyyy", vi)</td>
                        <td>@l.BaseUnit</td>
                        <td></td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="sign">
            <div><b>Người kiểm đếm</b><br /><span class="muted">(ký, ghi rõ họ tên)</span></div>
            <div><b>Người kiểm tra</b><br /><span class="muted">(ký, ghi rõ họ tên)</span></div>
        </div>
    </div>
</body>
</html>
