@model ExpiryReportViewModel
@{
    Layout = null;
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    string M(decimal v) => Format.Money(Math.Round(v));
    var i = 0;
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thuốc cận hạn @Model.Today.ToString("dd/MM/yyyy", vi) · @Model.PharmacyName</title>
    <style>
        @@page { size: A4; margin: 14mm 12mm; }
        * { box-sizing: border-box; }
        body { margin: 0; padding: 22px; font-family: "Segoe UI", Arial, sans-serif; font-size: 12px; color: #13302F; background: #fff; }
        .sheet { max-width: 800px; margin: 0 auto; }
        .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; border-bottom: 2px solid #13302F; padding-bottom: 10px; margin-bottom: 14px; }
        .brand { font-size: 17px; font-weight: 700; }
        h1 { font-size: 18px; margin: 0 0 4px; text-align: right; }
        h2 { font-size: 13px; margin: 14px 0 6px; }
        .right { text-align: right; }
        .muted { color: #4E6664; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
        th, td { border: 1px solid #C9D8D5; padding: 4px 6px; vertical-align: top; }
        th { background: #F1F6F5; text-align: left; }
        .r { text-align: right; white-space: nowrap; }
        .sign { display: grid; grid-template-columns: 1fr 1fr; text-align: center; margin-top: 28px; gap: 8px; }
        .sign div { min-height: 80px; }
        .tools { text-align: right; margin-bottom: 12px; }
        .tools button { font: inherit; padding: 8px 18px; border-radius: 999px; border: 0; background: #0B3B3E; color: #fff; cursor: pointer; }
        @@media print { body { padding: 0; } .tools { display: none; } }
    </style>
</head>
<body>
    <div class="sheet">
        <div class="tools"><button type="button" onclick="window.print()">In / Lưu PDF</button></div>
        <div class="head">
            <div>
                <div class="brand">@Model.PharmacyName</div>
                <div class="muted">Lập lúc @Format.When(DateTime.Now)</div>
            </div>
            <div>
                <h1>BÁO CÁO THUỐC CẬN HẠN</h1>
                <div class="muted right">Tính đến ngày @Model.Today.ToString("dd/MM/yyyy", vi)@(Model.CategoryName is null ? "" : " · " + Model.CategoryName)</div>
                <div class="muted right">Ngưỡng cảnh báo chung @Model.DefaultWarningDays ngày</div>
            </div>
        </div>

        <p>Đã hết hạn: <b>@Model.ExpiredLots lô</b>, giá vốn <b>@M(Model.ExpiredValue)</b> · Cận hạn: <b>@Model.NearLots lô</b>, giá vốn <b>@M(Model.NearValue)</b></p>

        <table>
            <thead>
                <tr>
                    <th>#</th><th>Thuốc</th><th>Số lô</th><th>Hạn dùng</th><th class="r">Còn (ngày)</th><th class="r">Tồn</th><th class="r">Giá vốn</th><th>Vị trí</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    i++;
                    <tr>
                        <td class="r">@i</td>
                        <td>@r.MedicineName <span class="muted">(@r.MedicineCode)</span></td>
                        <td>@r.BatchNumber</td>
                        <td>@r.ExpiryDate.ToString("dd/MM/yyyy", vi)</td>
                        <td class="r">@(r.Expired ? "Hết hạn" : r.DaysLeft.ToString(vi))</td>
                        <td class="r">@Format.Number(r.Quantity) @r.BaseUnit</td>
                        <td class="r">@M(r.Value)</td>
                        <td>@(r.Location ?? "")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="sign">
            <div><b>Người lập báo cáo</b><br /><span class="muted">(ký, ghi rõ họ tên)</span></div>
            <div><b>Chủ nhà thuốc</b><br /><span class="muted">(ký, ghi rõ họ tên)</span></div>
        </div>
    </div>
</body>
</html>
