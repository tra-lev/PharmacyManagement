@model string
@* Thẻ chuyển giữa hai báo cáo kho; chỉ hiện khi người xem có cả hai quyền. *@
<nav class="d-flex flex-wrap gap-2 mb-4" aria-label="Báo cáo kho">
    <a class="btn btn-sm @(Model == "movement" ? "btn-primary" : "btn-outline-secondary")" asp-action="Index" aria-current="@(Model == "movement" ? "page" : null)">Nhập – xuất – tồn</a>
    <a class="btn btn-sm @(Model == "expiry" ? "btn-primary" : "btn-outline-secondary")" asp-action="Expiry" aria-current="@(Model == "expiry" ? "page" : null)">Thuốc cận hạn</a>
</nav>
