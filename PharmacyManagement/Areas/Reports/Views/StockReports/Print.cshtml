@model StockMovementViewModel
@{
    Layout = null;
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var period = Model.From.ToString("dd/MM/yyyy", vi) + " – " + Model.To.ToString("dd/MM/yyyy", vi);
    string M(decimal v) => Format.Money(Math.Round(v));
    string Q(QtyValue v) => v.IsZero ? "" : Format.Number(v.Quantity);
    string V(QtyValue v) => v.IsZero ? "" : M(v.Value);
    var i = 0;
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nhập – xuất – tồn @period · @Model.PharmacyName</title>
    <style>
        @@page { size: A4 landscape; margin: 12mm 10mm; }
        * { box-sizing: border-box; }
        body { margin: 0; padding: 20px; font-family: "Segoe UI", Arial, sans-serif; font-size: 11.5px; color: #13302F; background: #fff; }
        .sheet { max-width: 1100px; margin: 0 auto; }
        .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; border-bottom: 2px solid #13302F; padding-bottom: 10px; margin-bottom: 12px; }
        .brand { font-size: 17px; font-weight: 700; }
        h1 { font-size: 18px; margin: 0 0 4px; text-align: right; }
        .right { text-align: right; }
        .muted { color: #4E6664; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
        th, td { border: 1px solid #C9D8D5; padding: 4px 6px; vertical-align: top; }
        th { background: #F1F6F5; text-align: center; }
        .r { text-align: right; white-space: nowrap; }
        .b { font-weight: 700; }
        .half { width: 50%; }
        .sign { display: grid; grid-template-columns: 1fr 1fr 1fr; text-align: center; margin-top: 28px; gap: 8px; }
        .sign div { min-height: 80px; }
        .tools { text-align: right; margin-bottom: 12px; }
        .tools button { font: inherit; padding: 8px 18px; border-radius: 999px; border: 0; background: #0B3B3E; color: #fff; cursor: pointer; }
        @@media print { body { padding: 0; } .tools { display: none; } }
    </style>
</head>
<body>
    <div class="sheet">
        <div class="tools"><button type="button" onclick="window.print()">In / Lưu PDF</button></div>
        <div class="head">
            <div>
                <div class="brand">@Model.PharmacyName</div>
                <div class="muted">Lập lúc @Format.When(DateTime.Now)</div>
            </div>
            <div>
                <h1>BÁO CÁO NHẬP – XUẤT – TỒN</h1>
                <div class="muted right">Từ @period@(Model.CategoryName is null ? "" : " · " + Model.CategoryName)@(Model.Filter.Q is null ? "" : " · thuốc: " + Model.Filter.Q)</div>
                <div class="muted right">Số lượng theo đơn vị cơ sở; giá trị theo giá vốn lô</div>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th rowspan="2">#</th>
                    <th rowspan="2">Thuốc</th>
                    <th rowspan="2">ĐVT</th>
                    <th colspan="2">Tồn đầu kỳ</th>
                    <th colspan="2">Nhập trong kỳ</th>
                    <th colspan="2">Xuất trong kỳ</th>
                    <th colspan="2">Tồn cuối kỳ</th>
                </tr>
                <tr>
                    <th>SL</th><th>Giá trị</th><th>SL</th><th>Giá trị</th><th>SL</th><th>Giá trị</th><th>SL</th><th>Giá trị</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    i++;
                    <tr>
                        <td class="r">@i</td>
                        <td>@r.Name <span class="muted">(@r.Code)</span></td>
                        <td>@r.BaseUnit</td>
                        <td class="r">@Q(r.Opening)</td><td class="r">@V(r.Opening)</td>
                        <td class="r">@Q(r.In)</td><td class="r">@V(r.In)</td>
                        <td class="r">@Q(r.Out)</td><td class="r">@V(r.Out)</td>
                        <td class="r b">@Q(r.Closing)</td><td class="r b">@V(r.Closing)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="b">
                    <td colspan="3" class="r">Tổng giá trị</td>
                    <td></td><td class="r">@M(Model.OpeningValue)</td>
                    <td></td><td class="r">@M(Model.InValue)</td>
                    <td></td><td class="r">@M(Model.OutValue)</td>
                    <td></td><td class="r">@M(Model.ClosingValue)</td>
                </tr>
            </tfoot>
        </table>

        <table class="half">
            <tbody>
                @foreach (var t in Model.ByType)
                {
                    <tr><td>@(t.IsIn ? "Nhập" : "Xuất"): @t.Name</td><td class="r">@M(t.Value)</td></tr>
                }
            </tbody>
        </table>

        <div class="sign">
            <div><b>Người lập báo cáo</b><br /><span class="muted">(ký, ghi rõ họ tên)</span></div>
            <div><b>Thủ kho</b><br /><span class="muted">(ký, ghi rõ họ tên)</span></div>
            <div><b>Chủ nhà thuốc</b><br /><span class="muted">(ký, ghi rõ họ tên)</span></div>
        </div>
    </div>
</body>
</html>
