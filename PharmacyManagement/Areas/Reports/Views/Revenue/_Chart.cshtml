@model RevenueChart
@functions {
    private static string F(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);

    /// <summary>Nhãn trục gọn: 1,2 tr; 350 ng.</summary>
    private static string Short(decimal v)
    {
        var vi = CultureInfo.GetCultureInfo("vi-VN");
        var a = Math.Abs(v);
        var sign = v < 0 ? "−" : "";
        if (a >= 1_000_000_000m) return sign + (a / 1_000_000_000m).ToString("0.#", vi) + " tỷ";
        if (a >= 1_000_000m) return sign + (a / 1_000_000m).ToString("0.#", vi) + " tr";
        if (a >= 1_000m) return sign + (a / 1_000m).ToString("0", vi) + " ng";
        return sign + a.ToString("0", vi);
    }

    /// <summary>Bước lưới "đẹp" (1, 2, 5 × 10^n).</summary>
    private static decimal NiceStep(decimal range)
    {
        if (range <= 0) return 1;
        var raw = (double)range / 4;
        var pow = Math.Pow(10, Math.Floor(Math.Log10(raw)));
        var unit = raw / pow;
        var nice = unit <= 1 ? 1 : unit <= 2 ? 2 : unit <= 5 ? 5 : 10;
        return (decimal)(nice * pow);
    }
}
@{
    var buckets = Model.Buckets;
    var values = buckets.Select(b => b.NetRevenue).ToList();
    if (Model.ShowProfit) values.AddRange(buckets.Select(b => b.GrossProfit));
    var max = Math.Max(0m, values.DefaultIfEmpty(0m).Max());
    var min = Math.Min(0m, values.DefaultIfEmpty(0m).Min());
    var step = NiceStep(max - min);
    max = Math.Ceiling(max / step) * step;
    min = Math.Floor(min / step) * step;
    if (max == min) max = min + step;

    const double W = 800, H = 260, Left = 64, Right = 8, Top = 10, Bottom = 28;
    var plotW = W - Left - Right;
    var plotH = H - Top - Bottom;
    double Y(decimal v) => Top + (double)((max - v) / (max - min)) * plotH;
    var n = Math.Max(1, buckets.Count);
    var group = plotW / n;
    var barW = Model.ShowProfit ? group * 0.36 : group * 0.64;
    var labelEvery = (int)Math.Ceiling(n / 12.0);
    var empty = buckets.All(b => b.NetRevenue == 0 && b.GrossProfit == 0);
}
@if (empty)
{
    <div class="pm-empty"><i class="bi bi-bar-chart" aria-hidden="true"></i> Chưa có doanh thu trong khoảng này.</div>
}
else
{
    <div class="pm-chart">
        <svg viewBox="0 0 @F(W) @F(H)" role="img" aria-label="Biểu đồ doanh thu thuần@(Model.ShowProfit ? " và lợi nhuận gộp" : "") theo thời gian">
            <g class="pm-chart-axis">
                @for (var t = min; t <= max; t += step)
                {
                    var y = Y(t);
                    <line class="@(t == 0 ? "pm-chart-zero" : "pm-chart-grid")" x1="@F(Left)" x2="@F(W - Right)" y1="@F(y)" y2="@F(y)" />
                    @:<text x="@F(Left - 6)" y="@F(y + 4)" text-anchor="end">@Short(t)</text>
                }
            </g>
            @for (var i = 0; i < buckets.Count; i++)
            {
                var b = buckets[i];
                var x0 = Left + group * i + (group - (Model.ShowProfit ? barW * 2 : barW)) / 2;
                var y0 = Y(0);
                var yr = Y(b.NetRevenue);
                <rect class="pm-bar-rev" x="@F(x0)" y="@F(Math.Min(yr, y0))" width="@F(Math.Max(barW, 1))" height="@F(Math.Abs(y0 - yr))">
                    <title>@b.Label — doanh thu thuần @Format.Money(b.NetRevenue)</title>
                </rect>
                if (Model.ShowProfit)
                {
                    var yp = Y(b.GrossProfit);
                    <rect class="@(b.GrossProfit < 0 ? "pm-bar-loss" : "pm-bar-profit")" x="@F(x0 + barW)" y="@F(Math.Min(yp, y0))" width="@F(Math.Max(barW, 1))" height="@F(Math.Abs(y0 - yp))">
                        <title>@b.Label — lợi nhuận gộp @Format.Money(Math.Round(b.GrossProfit))</title>
                    </rect>
                }
                if (i % labelEvery == 0)
                {
                    @:<text class="pm-chart-x" x="@F(Left + group * i + group / 2)" y="@F(H - 8)" text-anchor="middle">@b.ShortLabel</text>
                }
            }
        </svg>
    </div>
}
