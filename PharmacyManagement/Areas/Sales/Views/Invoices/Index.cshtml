@model InvoiceListViewModel
@{
    ViewData["Title"] = "Hóa đơn";
    var f = Model.Filter;
    string N(int n) => n.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"));
    string PageUrl(int page) => Url.Action("Index", new { f.Q, f.Status, page })!;
    var filtered = f.Q is not null || f.Status is not null;
}

<div class="pm-page-head">
    <div>
        <p class="pm-crumbs">Bán hàng</p>
        <h1 class="pm-title">Hóa đơn</h1>
        <p class="pm-subtitle"><span data-pm-live="count" aria-live="polite">@if (filtered)
            {
                <text>Tìm thấy @N(Model.Total) / @N(Model.GrandTotal) hóa đơn</text>
            }
            else
            {
                <text>@N(Model.GrandTotal) hóa đơn</text>
            }</span> · @(Model.ViewAll ? "toàn nhà thuốc" : "do bạn lập") · tìm theo mã hóa đơn, tên hoặc số điện thoại khách; gõ không dấu cũng được.</p>
    </div>
    @if (Model.CanSell)
    {
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-cart3" aria-hidden="true"></i> Bán lẻ</a>
    }
</div>

<form method="get" asp-action="Index" class="pm-card pm-filter pm-filter-1 mb-4" role="search" data-pm-live-search>
    <div class="pm-filter-search">
        <label for="q" class="visually-hidden">Tìm hóa đơn</label>
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" id="q" name="Q" value="@f.Q" class="form-control" placeholder="Mã hóa đơn, tên hoặc số điện thoại khách…" autocomplete="off" />
    </div>
    <div>
        <label for="status" class="visually-hidden">Trạng thái</label>
        <select id="status" name="Status" class="form-select">
            <!option value="" selected="@(f.Status is null)">Mọi trạng thái</!option>
            <!option value="pending" selected="@(f.Status == "pending")">Chờ thanh toán</!option>
            <!option value="paid" selected="@(f.Status == "paid")">Đã thanh toán</!option>
            <!option value="cancelled" selected="@(f.Status == "cancelled")">Đã hủy</!option>
        </select>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" data-pm-live-submit>Lọc</button>
        <span class="d-flex" data-pm-live="clear">
            @if (filtered)
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Bỏ lọc</a>
            }
        </span>
    </div>
</form>

<section class="pm-card pm-live-results" aria-label="Danh sách hóa đơn" data-pm-live="results">
    @if (Model.Rows.Count == 0)
    {
        <div class="pm-empty">
            <i class="bi bi-receipt" aria-hidden="true"></i>
            @(f.Q is null ? (filtered ? "Chưa có hóa đơn nào khớp bộ lọc." : "Chưa có hóa đơn nào.") : $"Không tìm thấy hóa đơn khớp “{f.Q}”.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="pm-table">
                <thead>
                    <tr>
                        <th scope="col">Hóa đơn</th>
                        <th scope="col">Khách hàng</th>
                        @if (Model.ViewAll)
                        {
                            <th scope="col">Người bán</th>
                        }
                        <th scope="col" class="text-end">Tổng tiền</th>
                        <th scope="col">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr class="pm-row-link">
                            <td>
                                <a class="fw-semibold text-reset stretched-link num" asp-action="Details" asp-route-id="@r.InvoiceId">@r.Code</a>
                                <div class="small text-muted-pm num">@Format.When(r.InvoiceDate) · @r.LineCount dòng@(r.HasPrescription ? " · theo đơn" : "")</div>
                            </td>
                            <td>@(r.CustomerName ?? "Khách lẻ")</td>
                            @if (Model.ViewAll)
                            {
                                <td class="small">@r.EmployeeName</td>
                            }
                            <td class="text-end num text-nowrap">@Format.Money(r.TotalAmount)</td>
                            <td><span class="pm-badge @InvoiceStatusText.Tone(r.Status)">@InvoiceStatusText.Of(r.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.PageCount > 1)
        {
            <nav class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3" aria-label="Phân trang">
                <span class="small text-muted-pm">Trang @f.Page / @Model.PageCount</span>
                <div class="d-flex gap-2">
                    @if (f.Page > 1)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page - 1)" rel="prev"><i class="bi bi-chevron-left" aria-hidden="true"></i> Trước</a>
                    }
                    @if (f.Page < Model.PageCount)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page + 1)" rel="next">Sau <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    }
                </div>
            </nav>
        }
    }
</section>

@section Scripts {
    <script src="~/js/live-search.js" asp-append-version="true"></script>
}
