@model ShiftDetailsViewModel
@{
    ViewData["Title"] = "Ca " + Model.Code;
    var t = Model.Totals;
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var closed = Model.Status == (byte)ShiftStatus.Closed;
    var paid = Model.Invoices.Where(i => i.Status == (byte)InvoiceStatus.Paid).ToList();
    var pending = Model.Invoices.Count(i => i.Status == (byte)InvoiceStatus.PendingPayment);
    var cancelled = Model.Invoices.Count(i => i.Status == (byte)InvoiceStatus.Cancelled);
}

<div class="pm-page-head">
    <div>
        <p class="pm-crumbs">
            @if (Model.IsOwnShift)
            {
                <a asp-action="Index">Ca làm việc</a>
            }
            else
            {
                <a asp-action="Index">Ca làm việc</a> <span>/</span> <a asp-action="All">Ca toàn nhà thuốc</a>
            }
            / @Model.Code
        </p>
        <h1 class="pm-title">Ca @Model.Code</h1>
        <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
            <span class="pm-badge mute">@Model.EmployeeName</span>
            @if (closed)
            {
                <span class="pm-badge mute">Đã chốt</span>
            }
            else if (Model.Status == (byte)ShiftStatus.HandedOver)
            {
                <span class="pm-badge wait">Đã bàn giao — chờ chốt tiền</span>
            }
            else
            {
                <span class="pm-badge good">Đang mở</span>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7 d-flex flex-column gap-4">
        <section class="pm-card" aria-labelledby="d-cash">
            <h2 id="d-cash" class="pm-h2 mb-3">@(closed ? "Biên bản chốt tiền" : "Tiền của ca (tạm tính)")</h2>
            <dl class="pm-dl">
                <dt>Tiền mặt đầu ca</dt><dd class="num">@Format.Money(t.OpeningCash)</dd>
                <dt>Tiền mặt bán</dt><dd class="num">+ @Format.Money(t.CashSales)</dd>
                <dt>Tiền mặt hoàn khách</dt><dd class="num">− @Format.Money(t.CashRefunds)</dd>
                <dt>Tiền mặt theo sổ</dt><dd class="num fw-semibold">@Format.Money(t.ExpectedCash)</dd>
                @if (closed)
                {
                    <dt>Tiền mặt thực đếm</dt><dd class="num fw-semibold">@Format.Money(Model.ActualCash)</dd>
                    <dt>Chênh lệch</dt>
                    <dd class="num">
                        @if (Model.Difference == 0)
                        {
                            <span class="pm-badge good">Khớp</span>
                        }
                        else if (Model.Difference is not null)
                        {
                            <span class="pm-badge @(Model.Difference > 0 ? "warn" : "bad")">@(Model.Difference > 0 ? "Thừa" : "Thiếu") @Format.Money(Math.Abs(Model.Difference.Value))</span>
                        }
                    </dd>
                    <dt>Giải trình</dt><dd class="pm-pre">@(Model.ClosingNotes ?? "—")</dd>
                }
                <dt>Chuyển khoản, thẻ</dt><dd class="num">@Format.Money(t.NonCashSales)</dd>
            </dl>
        </section>
    </div>

    <div class="col-lg-5 d-flex flex-column gap-4">
        <section class="pm-card" aria-labelledby="d-time">
            <h2 id="d-time" class="pm-h2 mb-3">Diễn biến ca</h2>
            <ul class="pm-timeline">
                <li>
                    <div class="small text-muted-pm num">@Format.When(Model.OpenedAt)</div>
                    <div class="fw-semibold">Mở ca</div>
                </li>
                @if (Model.HandedOverAt is not null)
                {
                    <li>
                        <div class="small text-muted-pm num">@Format.When(Model.HandedOverAt.Value)</div>
                        <div class="fw-semibold">Bàn giao ca</div>
                        @if (Model.HandoverNote is not null)
                        {
                            <div class="small pm-pre">@Model.HandoverNote</div>
                        }
                    </li>
                }
                @if (Model.ClosedAt is not null)
                {
                    <li>
                        <div class="small text-muted-pm num">@Format.When(Model.ClosedAt.Value)</div>
                        <div class="fw-semibold">Chốt tiền cuối ca</div>
                        @if (Model.ClosedByName is not null)
                        {
                            <div class="small text-muted-pm">@Model.ClosedByName</div>
                        }
                    </li>
                }
            </ul>
        </section>
    </div>
</div>

@* ---------------- Hóa đơn lập trong ca ---------------- *@
<section class="pm-card mt-4" aria-labelledby="d-invoices" data-pm-shift-invoices>
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h2 id="d-invoices" class="pm-h2 mb-1">Hóa đơn trong ca</h2>
            <p class="small text-muted-pm mb-0">
                Đã thanh toán @paid.Count.ToString("N0", vi) hóa đơn · @Format.Money(paid.Sum(i => i.TotalAmount))
                · Chờ thanh toán @pending.ToString("N0", vi) · Đã hủy @cancelled.ToString("N0", vi)
            </p>
        </div>
        @if (Model.Invoices.Count > 0)
        {
            <div class="pm-seg" role="radiogroup" aria-label="Lọc theo trạng thái">
                <label><input type="radio" name="inv-filter" value="" checked /> Tất cả</label>
                <label><input type="radio" name="inv-filter" value="@((byte)InvoiceStatus.Paid)" /> Đã thanh toán</label>
                <label><input type="radio" name="inv-filter" value="@((byte)InvoiceStatus.PendingPayment)" /> Chờ thanh toán</label>
                <label><input type="radio" name="inv-filter" value="@((byte)InvoiceStatus.Cancelled)" /> Đã hủy</label>
            </div>
        }
    </div>
    @if (Model.Invoices.Count == 0)
    {
        <div class="pm-empty"><i class="bi bi-receipt" aria-hidden="true"></i> Ca này chưa có hóa đơn nào.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="pm-table">
                <thead>
                    <tr>
                        <th scope="col">Hóa đơn</th>
                        <th scope="col">Khách hàng</th>
                        <th scope="col">Thu bằng</th>
                        <th scope="col" class="text-end">Tổng tiền</th>
                        <th scope="col">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Invoices)
                    {
                        <tr class="pm-row-link" data-pm-status="@i.Status">
                            <td>
                                <a class="fw-semibold text-reset stretched-link num" asp-controller="Invoices" asp-action="Details" asp-route-id="@i.InvoiceId">@i.Code</a>
                                <div class="small text-muted-pm num">@i.InvoiceDate.ToString("HH:mm", vi) · @(i.PrescriptionCode is null ? "Bán lẻ" : "Theo đơn " + i.PrescriptionCode)</div>
                            </td>
                            <td>@(i.CustomerName ?? "Khách lẻ")</td>
                            <td class="small">@(i.Methods.Count == 0 ? "—" : string.Join(", ", i.Methods.Select(PaymentMethodText.Of)))</td>
                            <td class="text-end num text-nowrap">@Format.Money(i.TotalAmount)</td>
                            <td><span class="pm-badge @InvoiceStatusText.Tone(i.Status)">@InvoiceStatusText.Of(i.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div hidden data-pm-shift-none>
            <div class="pm-empty"><i class="bi bi-receipt" aria-hidden="true"></i> Không có hóa đơn nào ở trạng thái này.</div>
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/shift-details.js" asp-append-version="true"></script>
}
