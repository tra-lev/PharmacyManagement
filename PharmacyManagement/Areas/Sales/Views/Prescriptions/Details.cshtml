@model PrescriptionDetailsViewModel
@{
    ViewData["Title"] = "Đơn thuốc " + Model.Code;
    string Or(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    string D(DateOnly d) => d.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);
}

<div class="pm-page-head">
    <div>
        <p class="pm-crumbs"><a asp-action="Index">Bán theo đơn</a> / @Model.Code</p>
        <h1 class="pm-title">Đơn thuốc @Model.Code</h1>
        <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
            <span class="pm-badge @PrescriptionStatusText.Tone(Model.Status)">@PrescriptionStatusText.Of(Model.Status)</span>
            @if (Model.IsSaved && Model.Expired)
            {
                <span class="pm-badge mute">Hết hạn mua</span>
            }
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.CanCancel)
        {
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#cancel-modal">Hủy đơn</button>
        }
        @if (Model.PendingInvoiceId is not null)
        {
            <a class="btn btn-primary" asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.PendingInvoiceId"><i class="bi bi-cash-coin" aria-hidden="true"></i> Đến hóa đơn chờ thanh toán</a>
        }
        else if (Model.CanSell)
        {
            <a class="btn btn-primary" asp-controller="Invoices" asp-action="Create" asp-route-prescriptionId="@Model.PrescriptionId"><i class="bi bi-cart3" aria-hidden="true"></i> Lập hóa đơn</a>
        }
    </div>
</div>

@if (Model.IsSaved && Model.Expired)
{
    <div class="pm-alert warn">Đơn đã hết hạn mua từ sau ngày @D(Model.ValidUntil). Khách cần đơn mới của bác sĩ.</div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <section class="pm-card h-100" aria-labelledby="d-head">
            <h2 id="d-head" class="pm-h2 mb-3">Thông tin đơn</h2>
            <dl class="pm-dl">
                <dt>Khách hàng</dt>
                <dd>
                    <a asp-area="Catalog" asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.CustomerName</a>
                    <span class="text-muted-pm">(@Model.CustomerCode@(Model.CustomerPhone is null ? "" : " · " + Model.CustomerPhone))</span>
                </dd>
                <dt>Bác sĩ</dt><dd>@Model.DoctorName</dd>
                <dt>Cơ sở khám</dt><dd>@Model.ClinicName</dd>
                <dt>Chẩn đoán</dt><dd class="pm-pre">@Or(Model.Diagnosis)</dd>
                <dt>Ngày kê</dt><dd class="num">@D(Model.PrescriptionDate)</dd>
                <dt>Hạn mua</dt><dd class="num">đến hết @D(Model.ValidUntil)</dd>
                <dt>Người tiếp nhận</dt><dd>@Model.CheckedByName</dd>
                <dt>Ghi chú</dt><dd class="pm-pre">@Or(Model.Notes)</dd>
            </dl>
        </section>
    </div>
    <div class="col-lg-5">
        <section class="pm-card h-100" aria-labelledby="d-inv">
            <h2 id="d-inv" class="pm-h2 mb-3">Hóa đơn</h2>
            @if (Model.Invoices.Count == 0)
            {
                <p class="text-muted-pm mb-0">Chưa lập hóa đơn.</p>
            }
            else
            {
                <ul class="pm-plain-list mb-0">
                    @foreach (var inv in Model.Invoices)
                    {
                        <li class="d-flex flex-wrap justify-content-between gap-2 py-1">
                            <span>
                                <a asp-controller="Invoices" asp-action="Details" asp-route-id="@inv.InvoiceId" class="fw-semibold num">@inv.Code</a>
                                <span class="small text-muted-pm num">· @Format.When(inv.InvoiceDate)</span>
                            </span>
                            <span class="text-nowrap">
                                <span class="num">@Format.Money(inv.TotalAmount)</span>
                                <span class="pm-badge @InvoiceStatusText.Tone(inv.Status) ms-1">@InvoiceStatusText.Of(inv.Status)</span>
                            </span>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
</div>

<section class="pm-card" aria-labelledby="d-lines">
    <h2 id="d-lines" class="pm-h2 mb-3">Thuốc trong đơn</h2>
    <div class="table-responsive">
        <table class="pm-table">
            <thead>
                <tr>
                    <th scope="col">Thuốc</th>
                    <th scope="col" class="text-end">Số lượng kê</th>
                    <th scope="col">Liều dùng</th>
                    <th scope="col">Cách dùng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Lines)
                {
                    var dose = string.Join(" · ", new[] { l.Dosage, l.Frequency, l.DurationDays is null ? null : l.DurationDays + " ngày" }.Where(x => !string.IsNullOrEmpty(x)));
                    <tr>
                        <td>
                            <span class="fw-semibold">@l.MedicineName</span>
                            <div class="small text-muted-pm num">@l.MedicineCode@(l.IsPrescription ? " · thuốc kê đơn" : "")</div>
                        </td>
                        <td class="text-end num text-nowrap">@Format.Number(l.Quantity) @l.UnitName</td>
                        <td>@Or(dose)</td>
                        <td>@Or(l.Instructions)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@if (Model.CanCancel)
{
    <div class="modal fade" id="cancel-modal" tabindex="-1" aria-labelledby="cancel-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" asp-action="Cancel" asp-route-id="@Model.PrescriptionId" method="post">
                <div class="modal-header">
                    <h2 class="modal-title pm-h2" id="cancel-title">Hủy đơn @Model.Code?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <p>Đơn chuyển sang Đã hủy và vẫn được lưu để tra cứu.</p>
                    <label for="cancel-reason" class="form-label">Lý do hủy <span class="req">*</span></label>
                    <input type="text" id="cancel-reason" name="reason" class="form-control" maxlength="300" required autocomplete="off" placeholder="Ví dụ: nhập sai đơn, khách không mua" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Không hủy</button>
                    <button type="submit" class="btn btn-danger">Hủy đơn</button>
                </div>
            </form>
        </div>
    </div>
}
