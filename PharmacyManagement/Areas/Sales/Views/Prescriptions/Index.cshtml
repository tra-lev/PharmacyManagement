@model PrescriptionListViewModel
@{
    ViewData["Title"] = "Bán theo đơn";
    var f = Model.Filter;
    string N(int n) => n.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"));
    string PageUrl(int page) => Url.Action("Index", new { f.Q, f.Status, page })!;
    var filtered = f.Q is not null || f.Status is not null;
}

<div class="pm-page-head">
    <div>
        <p class="pm-crumbs">Bán hàng</p>
        <h1 class="pm-title">Bán theo đơn</h1>
        <p class="pm-subtitle"><span data-pm-live="count" aria-live="polite">@if (filtered)
            {
                <text>Tìm thấy @N(Model.Total) / @N(Model.GrandTotal) đơn thuốc</text>
            }
            else
            {
                <text>@N(Model.GrandTotal) đơn thuốc</text>
            }</span> · tìm theo mã đơn, tên hoặc số điện thoại khách, tên bác sĩ; gõ không dấu cũng được.</p>
    </div>
    @if (Model.CanCreate)
    {
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i> Tiếp nhận đơn</a>
    }
</div>

<form method="get" asp-action="Index" class="pm-card pm-filter pm-filter-1 mb-4" role="search" data-pm-live-search>
    <div class="pm-filter-search">
        <label for="q" class="visually-hidden">Tìm đơn thuốc</label>
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" id="q" name="Q" value="@f.Q" class="form-control" placeholder="Mã đơn, tên hoặc số điện thoại khách, bác sĩ…" autocomplete="off" />
    </div>
    <div>
        <label for="status" class="visually-hidden">Trạng thái</label>
        <select id="status" name="Status" class="form-select">
            <!option value="" selected="@(f.Status is null)">Mọi trạng thái</!option>
            <!option value="saved" selected="@(f.Status == "saved")">Chưa bán</!option>
            <!option value="dispensed" selected="@(f.Status == "dispensed")">Đã bán</!option>
            <!option value="cancelled" selected="@(f.Status == "cancelled")">Đã hủy</!option>
        </select>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" data-pm-live-submit>Lọc</button>
        <span class="d-flex" data-pm-live="clear">
            @if (filtered)
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Bỏ lọc</a>
            }
        </span>
    </div>
</form>

<section class="pm-card pm-live-results" aria-label="Danh sách đơn thuốc" data-pm-live="results">
    @if (Model.Rows.Count == 0)
    {
        <div class="pm-empty">
            <i class="bi bi-file-earmark-medical" aria-hidden="true"></i>
            @(f.Q is null ? (filtered ? "Chưa có đơn thuốc nào khớp bộ lọc." : "Chưa có đơn thuốc nào.") : $"Không tìm thấy đơn thuốc khớp “{f.Q}”.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="pm-table">
                <thead>
                    <tr>
                        <th scope="col">Đơn thuốc</th>
                        <th scope="col">Khách hàng</th>
                        <th scope="col">Bác sĩ</th>
                        <th scope="col">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr class="pm-row-link">
                            <td>
                                <a class="fw-semibold text-reset stretched-link num" asp-action="Details" asp-route-id="@r.PrescriptionId">@r.Code</a>
                                <div class="small text-muted-pm num">Kê ngày @r.PrescriptionDate.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture) · @r.LineCount thuốc</div>
                            </td>
                            <td>@r.CustomerName</td>
                            <td>@r.DoctorName<div class="small text-muted-pm">@r.ClinicName</div></td>
                            <td>
                                <span class="pm-badge @PrescriptionStatusText.Tone(r.Status)">@PrescriptionStatusText.Of(r.Status)</span>
                                @if (r.Expired && r.Status == (byte)PrescriptionStatus.Saved)
                                {
                                    <span class="pm-badge mute">Hết hạn mua</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.PageCount > 1)
        {
            <nav class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3" aria-label="Phân trang">
                <span class="small text-muted-pm">Trang @f.Page / @Model.PageCount</span>
                <div class="d-flex gap-2">
                    @if (f.Page > 1)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page - 1)" rel="prev"><i class="bi bi-chevron-left" aria-hidden="true"></i> Trước</a>
                    }
                    @if (f.Page < Model.PageCount)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@PageUrl(f.Page + 1)" rel="next">Sau <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    }
                </div>
            </nav>
        }
    }
</section>

@section Scripts {
    <script src="~/js/live-search.js" asp-append-version="true"></script>
}
