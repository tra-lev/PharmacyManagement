@{
    // Thông báo một lần sau khi chuyển trang (TempData). Thành công tự ẩn; lỗi và cảnh báo giữ đến khi người dùng đóng.
    var toasts = new List<(string Css, string Icon, string Text, bool Auto, string Role)>();

    // Lỗi kiểm tra của form vừa gửi (ModelState) — gom lên đầu màn hình cho mọi trang. Tên ô lỗi gửi kèm để site.js viền đỏ, đưa con trỏ vào.
    var modelErrors = new List<string>();
    var invalidFields = new List<string>();
    if (!ViewData.ModelState.IsValid)
    {
        foreach (var entry in ViewData.ModelState)
        {
            if (entry.Value is null || entry.Value.Errors.Count == 0) continue;
            if (!string.IsNullOrEmpty(entry.Key)) invalidFields.Add(entry.Key);
            foreach (var e in entry.Value.Errors)
            {
                var text = string.IsNullOrWhiteSpace(e.ErrorMessage) ? "Giá trị nhập chưa hợp lệ." : e.ErrorMessage;
                if (!modelErrors.Contains(text)) modelErrors.Add(text);
            }
        }
    }
    if (TempData["Success"] is string ok) toasts.Add(("", "check-circle", ok, true, "status"));
    if (TempData["Info"] is string info) toasts.Add(("info", "info-circle", info, false, "status"));
    if (TempData["Warning"] is string warn) toasts.Add(("warn", "exclamation-triangle", warn, false, "alert"));
    if (TempData["Error"] is string err) toasts.Add(("bad", "x-circle", err, false, "alert"));
}
@if (toasts.Count > 0 || modelErrors.Count > 0)
{
    <div class="pm-toasts">
        @if (modelErrors.Count > 0)
        {
            <div class="pm-toast bad" role="alert" data-pm-model-errors data-pm-invalid="@(string.Join("|", invalidFields))">
                <i class="bi bi-x-circle" aria-hidden="true"></i>
                @if (modelErrors.Count == 1)
                {
                    <div>@modelErrors[0]</div>
                }
                else
                {
                    <div>
                        <p class="fw-semibold mb-1">Chưa lưu được — cần sửa @modelErrors.Count chỗ:</p>
                        <ul>
                            @foreach (var m in modelErrors)
                            {
                                <li>@m</li>
                            }
                        </ul>
                    </div>
                }
                <button type="button" data-pm-dismiss aria-label="Đóng thông báo">&times;</button>
            </div>
        }
        @foreach (var t in toasts)
        {
            <div class="pm-toast @t.Css" role="@t.Role" @(t.Auto ? "data-pm-autohide" : null)>
                <i class="bi bi-@t.Icon" aria-hidden="true"></i>
                <div>@t.Text</div>
                <button type="button" data-pm-dismiss aria-label="Đóng thông báo">&times;</button>
            </div>
        }
    </div>
}
