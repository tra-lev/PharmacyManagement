@model string
@* Model: id của ô mật khẩu mới. Điều kiện khớp cấu hình Identity (Program.cs); server vẫn kiểm tra lại. *@
<ul class="pm-rules" data-pm-rules-for="@Model" aria-label="Điều kiện mật khẩu">
    <li data-rule="length">Ít nhất 8 ký tự</li>
    <li data-rule="digit">Có chữ số</li>
    <li data-rule="lower">Có chữ thường</li>
    <li data-rule="upper">Có chữ hoa</li>
</ul>
