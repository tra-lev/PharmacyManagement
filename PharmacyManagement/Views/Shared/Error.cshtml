@model ErrorViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Có lỗi xảy ra";
}
<div>
    <h1>Có lỗi xảy ra</h1>
    <p class="text-muted-pm mb-0">Hệ thống chưa xử lý được yêu cầu. Thao tác vừa rồi có thể chưa được lưu — kiểm tra lại trước khi làm tiếp.</p>
</div>
@if (Model?.ShowRequestId == true)
{
    <div class="pm-inner small">Mã tra cứu lỗi: <code>@Model.RequestId</code> (gửi mã này cho nhóm kỹ thuật).</div>
}
<a class="btn btn-primary" href="/">Về trang tổng quan</a>
