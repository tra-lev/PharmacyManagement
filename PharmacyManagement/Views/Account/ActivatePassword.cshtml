@model ActivatePasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đặt mật khẩu";
}
<partial name="_Steps" model="@((2, new[] { "Nhập mã", "Đặt mật khẩu", "Đăng nhập" }))" />
<div>
    <h1>Đặt mật khẩu</h1>
    <p class="text-muted-pm mb-0">Mã đúng. Kiểm tra thông tin rồi tự đặt mật khẩu cho tài khoản của bạn.</p>
</div>

<dl class="pm-inner row g-0 small mb-0">
    <dt class="col-4 text-muted-pm fw-normal">Họ tên</dt><dd class="col-8 mb-1 fw-semibold">@Model.FullName</dd>
    <dt class="col-4 text-muted-pm fw-normal">Tên tài khoản</dt><dd class="col-8 mb-1 fw-semibold">@AccountHelpers.UserNameFromEmail(Model.Email)</dd>
    <dt class="col-4 text-muted-pm fw-normal">Email đăng nhập</dt><dd class="col-8 mb-1 text-break">@Model.Email</dd>
    <dt class="col-4 text-muted-pm fw-normal">Vai trò</dt><dd class="col-8 mb-0">@Model.RoleDisplay</dd>
</dl>

<form asp-action="ActivatePassword" method="post" class="d-flex flex-column gap-3">
    <div asp-validation-summary="ModelOnly" class="pm-alert bad" role="alert"></div>
    <input type="hidden" asp-for="Ticket" />
    @* Giúp trình quản lý mật khẩu lưu đúng tài khoản; server không đọc ô này. *@
    <input type="hidden" name="username" value="@Model.Email" autocomplete="username" />
    <div>
        <label asp-for="NewPassword" class="form-label"></label>
        <div class="pm-pw-wrap">
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
            <button type="button" class="pm-pw-toggle" data-pm-toggle-password="NewPassword" aria-pressed="false" aria-label="Hiện mật khẩu">Hiện</button>
        </div>
        <partial name="_PasswordRules" model="@("NewPassword")" />
        <span asp-validation-for="NewPassword" class="field-validation-error"></span>
    </div>
    <div>
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Kích hoạt tài khoản</button>
    <p class="form-text mb-0">Phiên này có hiệu lực 15 phút. Quá hạn thì nhập lại mã (nếu mã còn hạn) hoặc nhờ chủ nhà thuốc gửi lại.</p>
</form>

@section Scripts { <partial name="_FormValidation" /> }
