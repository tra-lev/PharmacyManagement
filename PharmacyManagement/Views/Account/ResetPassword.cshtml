@model ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đặt lại mật khẩu";
}
<div>
    <h1>Đặt lại mật khẩu</h1>
    <p class="text-muted-pm mb-0">Nhập mã 6 số trong email (hiệu lực 15 phút) và mật khẩu mới.</p>
</div>

<form asp-action="ResetPassword" method="post" class="d-flex flex-column gap-3">
    <div asp-validation-summary="ModelOnly" class="pm-alert bad" role="alert"></div>
    <div>
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="username" />
        <span asp-validation-for="Email" class="field-validation-error"></span>
    </div>
    <div>
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control pm-code" data-pm-lazy inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="••••••" autofocus />
        <span asp-validation-for="Code" class="field-validation-error"></span>
    </div>
    <div>
        <label asp-for="NewPassword" class="form-label"></label>
        <div class="pm-pw-wrap">
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <button type="button" class="pm-pw-toggle" data-pm-toggle-password="NewPassword" aria-pressed="false" aria-label="Hiện mật khẩu">Hiện</button>
        </div>
        <partial name="_PasswordRules" model="@("NewPassword")" />
        <span asp-validation-for="NewPassword" class="field-validation-error"></span>
    </div>
    <div>
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Đặt mật khẩu mới</button>
</form>

<form asp-action="ForgotPassword" method="post" class="small text-muted-pm">
    <input type="hidden" name="Email" value="@Model.Email" />
    Chưa nhận được mã? Kiểm tra mục Spam, hoặc
    <button type="submit" class="btn btn-link small align-baseline" disabled="@string.IsNullOrWhiteSpace(Model.Email)">gửi lại mã</button>
    (sau 60 giây).
    <a asp-action="Login" class="d-block mt-2">← Quay lại đăng nhập</a>
</form>

@section Scripts { <partial name="_FormValidation" /> }
