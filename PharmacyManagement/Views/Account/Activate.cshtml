@model ActivateCodeViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Kích hoạt tài khoản";
}
<partial name="_Steps" model="@((1, new[] { "Nhập mã", "Đặt mật khẩu", "Đăng nhập" }))" />
<div>
    <h1>Kích hoạt tài khoản</h1>
    <p class="text-muted-pm mb-0">Nhập email chủ nhà thuốc đã mời và mã 6 số trong thư mời.</p>
</div>

<form asp-action="Activate" method="post" class="d-flex flex-column gap-3">
    <div asp-validation-summary="ModelOnly" class="pm-alert bad" role="alert"></div>
    <div>
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="username" />
        <span asp-validation-for="Email" class="field-validation-error"></span>
    </div>
    <div>
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control pm-code" data-pm-lazy inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="••••••" />
        <span asp-validation-for="Code" class="field-validation-error"></span>
        <div class="form-text">Mã có hiệu lực 15 phút, nhập sai quá 5 lần thì mã bị hủy.</div>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Tiếp tục</button>
</form>

<div class="pm-inner small">
    Mã hết hạn, nhập sai quá số lần, hoặc email sai? Báo chủ nhà thuốc <strong>gửi lại lời mời</strong>.
    Mỗi nhân viên chỉ có một email đăng nhập; muốn đổi email cũng phải báo chủ nhà thuốc.
</div>
<a asp-action="Login" class="small">← Đã có mật khẩu? Đăng nhập</a>

@section Scripts { <partial name="_FormValidation" /> }
