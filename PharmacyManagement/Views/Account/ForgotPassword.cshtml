@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Quên mật khẩu";
}
<div>
    <h1>Quên mật khẩu</h1>
    <p class="text-muted-pm mb-0">Nhập email đăng nhập. Hệ thống gửi mã 6 số để bạn đặt mật khẩu mới.</p>
</div>

<form asp-action="ForgotPassword" method="post" class="d-flex flex-column gap-3">
    <div asp-validation-summary="ModelOnly" class="pm-alert bad" role="alert"></div>
    <div>
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Email" class="field-validation-error"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Gửi mã</button>
</form>

<p class="small text-muted-pm mb-0">
    Không còn dùng được email cũ? Báo chủ nhà thuốc đổi email cho bạn.
    <a asp-action="Login" class="d-block mt-2">← Quay lại đăng nhập</a>
</p>

@section Scripts { <partial name="_FormValidation" /> }
